APP_ENV=development
DATABASE_URL=sqlite:///./data/runtime/lumasupply.db
APP_HOST=127.0.0.1
APP_PORT=8000
# Configure only for real external integration. Never commit .env.
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_IMAGESEARCH_ENDPOINT=
ALIYUN_IMAGESEARCH_INSTANCE=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
SMS_ENDPOINT=
SMS_TOKEN=
IMAGE_ENCODER=handcrafted
CHINESE_CLIP_MODEL=ViT-B-16

# Merchant mini-program has its own WeChat AppID and secret.
WECHAT_MERCHANT_APP_ID=
WECHAT_MERCHANT_APP_SECRET=

# Management authentication: TOTP secrets keyed by user ID, stored outside Git.
MFA_SECRETS_FILE=
MFA_TOTP_SECRETS=
AUTH_FAILURE_LIMIT=5
AUTH_SOURCE_LIMIT=100
SMS_SOURCE_LIMIT=20
