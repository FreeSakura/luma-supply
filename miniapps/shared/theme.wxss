/* Shared native visual layer. Public catalog images and business data stay unchanged. */
page{background:#f6f6ef;color:#243d32;font-size:28rpx;line-height:1.6;font-family:system-ui,-apple-system,'PingFang SC','Microsoft YaHei',sans-serif}
.page{padding:32rpx 30rpx 48rpx}.brand{font-size:40rpx;font-weight:600;letter-spacing:-1rpx;color:#214934}.eyebrow{font-size:19rpx;letter-spacing:3rpx;color:#8f9d7c}.section{font-size:36rpx;line-height:1.5;letter-spacing:-.5rpx}.muted{font-size:25rpx;color:#7d8e6c;line-height:1.85}.tiny{font-size:22rpx;color:#8b9c79;line-height:1.8}.field{font-size:25rpx;color:#546e46;margin:25rpx 0 10rpx}
button{font-weight:500;font-size:27rpx;min-height:88rpx;border-radius:14rpx;line-height:1.6;padding:20rpx 26rpx;display:flex;align-items:center;justify-content:center;color:#426233;background:#fff;border:1rpx solid #dfe7d3;margin:18rpx 0;box-sizing:border-box}button[disabled]{opacity:.48}.primary{background:#284f39;color:#fff;border:0;box-shadow:0 5rpx 12rpx #25442b12}.small{font-size:24rpx;min-height:76rpx;padding:13rpx 20rpx;margin:10rpx 0}.button{font-size:26rpx}.row{gap:20rpx}.card{padding:30rpx;border:1rpx solid #e2e7d7;border-radius:24rpx;box-shadow:0 5rpx 20rpx #28422004;margin:25rpx 0;background:#fff}.divider{background:#e6ecdb;margin:28rpx 0}
input,textarea,.picker{font-size:28rpx;background:#fcfdf9;border-color:#dce5d0;border-radius:13rpx;padding:20rpx;min-height:88rpx;line-height:1.6;color:#2c4d36}input{height:88rpx}textarea{height:180rpx}.check{font-size:25rpx;gap:12rpx;line-height:1.7}checkbox{transform:scale(.86);margin-left:-8rpx}.notice{padding:23rpx 25rpx;background:#eef4e4;color:#748b5c;border:1rpx solid #e3ebd5;border-radius:14rpx;font-size:24rpx;line-height:1.9}
.hero{padding:40rpx 34rpx;background:linear-gradient(125deg,#e5ebd8,#f3efde);border:1rpx solid #e1e5d2;border-radius:26rpx;margin:28rpx 0}.hero .title{font-size:47rpx;letter-spacing:-1rpx;line-height:1.55;font-weight:600;max-width:560rpx;margin:9rpx 0 17rpx}.hero .muted{font-size:25rpx;color:#7c8c68}.merchant .hero{background:linear-gradient(125deg,#204737,#335843);border:0}.merchant .hero .title{color:#f5f4e8}.merchant .hero .muted{color:#bacbac}.merchant .hero .eyebrow{color:#a8be92}.home-shortcuts{display:flex;gap:16rpx;margin:16rpx 0 24rpx}.home-shortcuts button{flex:1;min-width:0;font-size:25rpx;margin:0;background:#fff;border-radius:15rpx;padding:19rpx 8rpx;min-height:84rpx}
.supplier-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin:25rpx 0 30rpx}.supplier-tile{padding:28rpx 30rpx;background:#fff;border:1rpx solid #e0e6d5;border-radius:21rpx;display:flex;flex-direction:column;gap:12rpx}.supplier-tile .tiny{font-size:24rpx}.stat-value{font-size:58rpx;line-height:1.3;color:#345939;font-weight:500}.stat-link{font-size:22rpx;color:#94a27f}.search-card{padding:28rpx 25rpx}.search-label{font-size:26rpx;color:#587248;font-weight:500;margin-bottom:19rpx}.search-card>.row{gap:16rpx}.search-card>.row button{font-size:25rpx}.search-card .tiny{margin-top:14rpx}.grid{gap:23rpx}.product{border-radius:21rpx;box-shadow:0 4rpx 15rpx #3c552606;border-color:#e0e7d2}.product image{height:272rpx;background:#efeee1}.product-copy{padding:24rpx 23rpx}.product-name{font-size:29rpx;line-height:1.6;letter-spacing:0;font-weight:600;margin:9rpx 0}.price{font-size:38rpx;letter-spacing:-1rpx;font-weight:500;color:#35593a;margin-top:12rpx}.price .tiny{font-size:21rpx;font-weight:400}.card-action{font-size:24rpx;background:#edf3e2;border:0;color:#456b37;min-height:73rpx;padding:14rpx 17rpx;margin:20rpx 0 0;border-radius:11rpx;justify-content:space-between}.product-placeholder{height:272rpx;background:#eef0e4;color:#93a183;display:flex;align-items:center;justify-content:center;font-size:24rpx}
.pill{font-size:22rpx;display:inline-flex;line-height:1.5;background:#e9f1dd;color:#65864b;border-radius:9rpx;padding:9rpx 16rpx}.tone-pending{background:#fcf0d7;color:#aa7e33}.tone-rejected,.tone-expired{background:#f7e9df;color:#a16e4b}.tone-approved{background:#e7f1dd;color:#5a8347}.tone-inactive,.tone-deleted{background:#ecefe6;color:#869477}.tabs{gap:14rpx;margin:26rpx 0;flex-wrap:wrap}.tabs button{font-size:25rpx;min-height:75rpx;padding:14rpx 22rpx;line-height:1.6;border-radius:13rpx;background:#fff;margin:0}.tabs .active{background:#2c543b;border-color:#2c543b;color:#fff}.work-heading{padding:5rpx 2rpx 12rpx}.work-heading .section{margin:14rpx 0}.work-filter{margin:20rpx 0}.work-filter>.tiny{margin:14rpx 3rpx}.filter-chips{display:flex;gap:12rpx;flex-wrap:wrap;margin:20rpx 0}.filter-chips button{min-height:65rpx;padding:10rpx 20rpx;font-size:23rpx;border-radius:32rpx;margin:0}.filter-chips button.active{background:#e6efda;border-color:#c5d7b2;color:#45693a}
.detail-image{height:475rpx;border-radius:25rpx;background:#eeedde}.thumb{width:138rpx;height:118rpx;border-radius:14rpx;flex-shrink:0}.support image{width:180rpx;height:180rpx}.modal{padding:24rpx;background:#193f2b80}.sheet{border-radius:26rpx;padding:36rpx 30rpx;max-height:88vh;box-shadow:0 22rpx 70rpx #193f2b20}.sheet>.section{margin-top:4rpx}.sheet .card{padding:24rpx;border-radius:18rpx;margin:20rpx 0}.sheet .muted{white-space:pre-wrap;overflow-wrap:break-word}.empty{padding:85rpx 28rpx;font-size:27rpx;color:#98a783}.profile-banner{display:flex;gap:24rpx;align-items:center;padding:30rpx;background:#e8efdc;border-radius:22rpx;margin:25rpx 0}.profile-avatar{width:96rpx;height:96rpx;display:flex;align-items:center;justify-content:center;background:#fff;border-radius:50%;font-size:38rpx;color:#537b41;flex-shrink:0}.profile-title{font-size:34rpx;font-weight:600}.merchant .profile-banner{background:#264c38}.merchant .profile-title{color:#f3f2e5}.merchant .profile-banner .muted{color:#b6c6a4}
