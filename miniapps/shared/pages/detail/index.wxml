<view wx:if="{{product}}" class="page"><image class="detail-image" src="{{sku.picture}}" mode="aspectFit" bindtap="preview"/><view class="card"><view class="eyebrow">{{product.category}} / {{sku.code}}</view><view class="section">{{product.name}}</view><view class="muted">{{product.description}}</view><view class="price">{{sku.priceText}}</view><text class="field">选择规格 / Variant</text><picker range="{{product.skus}}" range-key="label" value="{{index}}" bindchange="select"><view class="picker">{{sku.label}}</view></picker><view class="divider"/><view class="row between"><text>尺寸 / mm</text><text>{{sku.size_mm||'待补充'}}</text></view><view wx:for="{{sku.attributeList}}" wx:key="key" class="row between"><text class="muted">{{item.key}}</text><text>{{item.value}}</text></view><view class="row"><button class="grow" bindtap="compare">参数对比 / Compare</button><button class="grow" open-type="share">分享 SKU / Share</button></view><block wx:if="{{role==='customer'}}"><input value="{{room}}" data-key="room" bindinput="input" placeholder="房间 / Room"/><button class="primary" bindtap="wish">加入选购清单 / Add to list</button></block><button wx:else class="primary" bindtap="quote">我要报价 / Submit offer</button></view><view class="card support"><view class="section">联系客服购买 / Support</view><view class="muted">批发与定制面议 / Wholesale and custom</view><view wx:for="{{support}}" wx:key="image"><image src="{{item.picture}}" data-url="{{item.picture}}" bindtap="support"/><view>{{item.nickname}}</view></view></view><view class="card" wx:for="{{reviews}}" wx:key="id"><view>{{item.text}}</view><view class="muted">{{item.reply}}</view></view><view wx:if="{{quote}}" class="modal"><view class="sheet"><view class="section">供货报价 / Offer</view><text class="field">单价 ¥</text><input type="digit" data-key="form.price" bindinput="input"/><text class="field">可供数量 留空待确认</text><input type="number" data-key="form.available_quantity" bindinput="input"/><text class="field">交期 天</text><input type="number" value="{{form.lead_days}}" data-key="form.lead_days" bindinput="input"/><text class="field">运费 ¥</text><input type="digit" value="{{form.freight}}" data-key="form.freight" bindinput="input"/><view class="notice">报价有效期 30 天，每次提交产生新版本，审核后生效。</view><button class="primary" bindtap="submitQuote">提交审核 / Submit</button><button bindtap="close">取消 / Cancel</button></view></view><view wx:if="{{compareOpen}}" class="modal"><view class="sheet"><view class="section">规格对比 / Comparison</view><view wx:for="{{comparison}}" wx:key="id" class="card"><view>{{item.product_name}} · {{item.code}}</view><view class="price">{{item.priceText}}</view><view class="muted">{{item.color}} · {{item.size_mm}} · {{item.specification}}</view><view class="tiny">功率 {{item.attributes.power_w||'待补充'}} W · 色温 {{item.attributes.cct_k||'待补充'}} K</view></view><button bindtap="clearCompare">清除对比 / Clear</button><button bindtap="close">返回 / Back</button></view></view></view>
