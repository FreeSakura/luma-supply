<view class="page"><view class="eyebrow">LUMASUPPLY WORKSPACE</view><view class="section">业务协同 / Workspace</view><view class="tabs"><button wx:for="{{tabs}}" wx:key="key" class="{{tab===item.key?'active':''}}" data-key="{{item.key}}" bindtap="tab">{{item.name}}</button></view><button wx:if="{{tab==='wishlist'&&rows.length}}" class="primary" bindtap="inquire">清单一键询价 / Request quote</button><button wx:if="{{tab==='catalog'}}" class="primary" bindtap="newProduct">新增商品 / New product</button>
<block wx:for="{{rows}}" wx:key="id"><view class="card"><block wx:if="{{tab==='wishlist'}}"><view class="row"><image class="thumb" src="{{item.picture}}"/><view class="grow"><view>{{item.product_name}}</view><view class="tiny">{{item.sku.code}} · {{item.room}}</view><view class="price">{{item.priceText}}</view></view><button class="small" data-id="{{item.id}}" bindtap="deleteWish">×</button></view><text class="field">数量 / Quantity</text><input type="number" value="{{item.quantity}}" data-id="{{item.id}}" bindblur="quantity"/></block>
<block wx:elif="{{tab==='orders'}}"><view class="tiny">{{item.number}}</view><view class="row between"><view class="price">{{item.priceText}}</view><view class="pill">{{item.status}}</view></view><view class="muted">客服 {{item.service_name}} / {{item.shipment_status}}</view><button data-id="{{item.id}}" bindtap="openOrder">订单详情 / Details</button></block>
<block wx:elif="{{tab==='inquiries'}}"><view>询价 / Inquiry #{{item.id}}</view><view class="muted">{{item.summary}}</view><view class="pill">{{item.status}}</view></block>
<block wx:elif="{{tab==='tickets'}}"><view>售后 / Ticket #{{item.id}} · {{item.status}}</view><view class="muted">{{item.description}}</view><view class="tiny" wx:for="{{item.history}}" wx:for-item="h" wx:key="at">{{h.by}}: {{h.note}}</view><button wx:if="{{item.status==='need_information'}}" data-id="{{item.id}}" bindtap="supplement">补充资料 / Add information</button></block>
<block wx:elif="{{tab==='quotes'}}"><view class="row between"><view>{{item.sku_code}} · v{{item.version}}</view><view class="pill">{{item.status}}</view></view><view class="price">{{item.priceText}}</view><view class="tiny">库存 {{item.available_quantity===null?'待确认':item.available_quantity}} · 交期 {{item.lead_days}} 天</view><view class="muted">{{item.reason}}</view><view wx:if="{{!item.deleted}}" class="row wrap"><button class="small" data-id="{{item.id}}" bindtap="revise">修改报价 / Revise</button><button class="small" data-id="{{item.id}}" data-action="{{item.active?'withdraw':'resubmit'}}" bindtap="quoteAction">{{item.active?'下架 / Withdraw':'重新上架 / Resubmit'}}</button><button class="small" data-id="{{item.id}}" data-action="delete" bindtap="quoteAction">删除 / Delete</button></view></block>
<block wx:elif="{{tab==='catalog'}}"><view class="row"><image class="thumb" src="{{item.picture}}"/><view><view>{{item.name}}</view><view class="tiny">{{item.title}}</view><view class="pill">{{item.status}}</view></view></view><button data-id="{{item.id}}" bindtap="editProduct">编辑并重新审核 / Edit</button></block></view></block><view wx:if="{{!rows.length}}" class="empty">暂无记录 / No records</view>
<view wx:if="{{modal}}" class="modal"><view class="sheet"><block wx:if="{{modal==='order'}}"><view class="section">订单详情 / Order</view><view class="tiny">{{order.number}}</view><view class="pill">{{order.status}}</view><view wx:for="{{order.lines}}" wx:key="id" class="card"><view>{{item.snapshot.product_name}}</view><view class="tiny">{{item.snapshot.code}} · {{item.snapshot.specification}}</view><view>{{item.quantity}} × {{item.priceText}} · 已发 {{item.shipped_quantity}}</view></view><view wx:if="{{order.address_snapshot}}" class="muted">{{order.address_snapshot.recipient}} {{order.address_snapshot.phone}} {{order.address_snapshot.detail}}</view><view wx:for="{{order.shipments}}" wx:for-item="ship" wx:key="id" class="card"><view>{{ship.carrier}} {{ship.tracking||'自提 / Pickup'}}</view><button wx:for="{{ship.proof_media_ids}}" wx:for-item="proof" wx:key="*this" data-id="{{proof}}" bindtap="proof">查看凭证 / Proof</button></view><block wx:if="{{order.status==='awaiting_confirmation'}}"><view class="check"><switch bindchange="delivery"/><text>{{form.delivery_mode==='delivery'?'配送 / Delivery':'自提 / Pickup'}}</text></view><picker wx:if="{{form.delivery_mode==='delivery'}}" range="{{addresses}}" range-key="detail" bindchange="selectAddress"><view class="picker">{{form.address_label||'选择收货地址 / Address'}}</view></picker><button class="primary" bindtap="confirm">确认订单 / Confirm</button></block><button wx:if="{{order.status==='awaiting_confirmation'||order.status==='confirmed'}}" bindtap="cancel">取消订单 / Cancel order</button><button wx:if="{{order.status==='fulfilling'}}" class="primary" bindtap="receive">全部签收 / Receive all</button><button wx:if="{{order.status==='completed'}}" bindtap="review">评价商品 / Review</button><button wx:if="{{order.status==='completed'||order.status==='fulfilling'}}" bindtap="ticket">申请售后 / After-sales</button></block>
<block wx:elif="{{modal==='review'||modal==='ticket'}}"><view class="section">{{modal==='review'?'商品评价 / Review':'售后申请 / After-sales'}}</view><picker range="{{order.lines}}" range-key="sku_id" bindchange="itemSelect"><view class="picker">{{form.itemLabel||'选择订单规格 / SKU'}}</view></picker><block wx:if="{{modal==='ticket'}}"><text class="field">数量 / Quantity</text><input type="number" value="{{form.quantity}}" data-key="quantity" bindinput="input"/><text class="field">说明 / Description</text><textarea data-key="description" bindinput="input"/></block><block wx:else><text class="field">评价 / Review</text><textarea data-key="text" bindinput="input"/></block><button bindtap="attach">{{form.media_id?'附件已上传':'上传图片或视频'}}</button><button class="primary" bindtap="submitFeedback">提交 / Submit</button></block>
<block wx:elif="{{modal==='quote'}}"><view class="section">报价新版本 / Revise offer</view><text class="field">供货单价 ¥</text><input type="digit" value="{{form.price}}" data-key="price" bindinput="input"/><text class="field">库存数量</text><input type="number" value="{{form.available_quantity}}" data-key="available_quantity" bindinput="input"/><text class="field">交期 天</text><input type="number" value="{{form.lead_days}}" data-key="lead_days" bindinput="input"/><text class="field">运费 ¥</text><input type="digit" value="{{form.freight}}" data-key="freight" bindinput="input"/><button class="primary" bindtap="saveQuote">提交审核 / Submit</button></block>
<block wx:elif="{{modal==='product'||modal==='edit-product'}}"><view class="section">商品资料 / Product</view><text class="field">名称 / Name</text><input value="{{form.name}}" data-key="name" bindinput="input"/><text class="field">标题 / Title</text><input value="{{form.title}}" data-key="title" bindinput="input"/><text class="field">分类 / Category</text><input value="{{form.category}}" data-key="category" bindinput="input"/><text class="field">说明 / Description</text><textarea value="{{form.description}}" data-key="description" bindinput="input"/><block wx:if="{{modal==='product'}}"><text class="field">SKU</text><input data-key="code" bindinput="input"/><text class="field">尺寸 mm</text><input data-key="size_mm" bindinput="input"/><text class="field">规格 / Specification</text><input data-key="specification" bindinput="input"/><text class="field">初始价格 ¥</text><input type="digit" data-key="price" value="{{form.price}}" bindinput="input"/><text class="field">功率 W</text><input type="number" data-key="power_w" value="{{form.power_w}}" bindinput="input"/><text class="field">色温 K</text><input type="number" data-key="cct_k" value="{{form.cct_k}}" bindinput="input"/><button bindtap="productImage">{{form.image?'图片已上传':'上传商品图片'}}</button></block><button class="primary" bindtap="saveProduct">提交审核 / Submit</button></block>
<block wx:elif="{{modal==='supplement'}}"><view class="section">补充售后资料 / More information</view><textarea data-key="note" bindinput="input"/><button bindtap="attach">上传附件 / Upload</button><button class="primary" bindtap="saveSupplement">提交 / Submit</button></block><button bindtap="close">关闭 / Close</button></view></view></view>
