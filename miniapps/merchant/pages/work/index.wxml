<view class="page {{role}}"><view class="work-heading"><view class="eyebrow">LUMASUPPLY WORKSPACE</view><view class="section">{{role==='merchant'?'我的供货工作台':'选购与订单'}}</view><view class="muted">{{role==='merchant'?'把握报价进度，及时更新供货。':'从房间清单到收货，进度都在这里。'}}</view></view><view class="tabs"><button wx:for="{{tabs}}" wx:key="key" class="{{tab===item.key?'active':''}}" data-key="{{item.key}}" bindtap="tab">{{item.name}}</button></view><view wx:if="{{tab==='wishlist'&&rows.length}}" class="card"><view class="section">按房间规划 / Plan by room</view><picker range="{{roomOptions}}" value="{{roomIndex}}" bindchange="chooseRoom"><view class="picker">{{roomOptions[roomIndex]}}</view></picker><view class="price">{{selectedAmount}}</view><view class="muted">已选 {{selectedIds.length}} 项 · {{selectedQuantity}} 件。参考金额不含运费与安装。</view></view><button wx:if="{{tab==='wishlist'&&rows.length}}" class="primary" bindtap="inquire">清单一键询价 / Request quote</button><button wx:if="{{tab==='catalog'}}" class="primary" bindtap="newProduct">新增商品 / New product</button>
<picker wx:if="{{tab==='inquiries'}}" range="{{inquiryStatusOptions}}" value="{{inquiryStatusIndex}}" bindchange="inquiryStatus"><view class="picker">{{inquiryStatusOptions[inquiryStatusIndex]}}</view></picker><view class="work-filter"><input value="{{filterText}}" bindinput="filterInput" placeholder="搜索编号、商品或项目…"/><view class="filter-chips" wx:if="{{tab==='quotes'}}"><button wx:for="{{quoteFilters}}" wx:key="value" class="{{filterStatus===item.value?'active':''}}" data-status="{{item.value}}" bindtap="filterOffers">{{item.label}}</button></view><view class="tiny">显示 {{visibleRows.length}} / {{rows.length}} 条记录</view></view><block wx:for="{{visibleRows}}" wx:key="id"><view class="card"><block wx:if="{{tab==='wishlist'}}"><checkbox-group data-id="{{item.id}}" bindchange="toggleWish"><label class="check"><checkbox value="{{item.id}}" checked="{{item.selected}}"/>{{item.room}} · {{item.sku.code}}</label></checkbox-group><view class="row"><image class="thumb" src="{{item.picture}}"/><view class="grow"><view>{{item.product_name}}</view><view class="tiny">{{item.sku.code}} · {{item.room}}</view><view class="price">{{item.priceText}}</view></view><button class="small" data-id="{{item.id}}" bindtap="deleteWish">×</button></view><text class="field">数量 / Quantity</text><view class="muted">数量 / Quantity × {{item.quantity}}</view><view wx:if="{{item.note}}" class="muted">{{item.note}}</view><button class="small" data-id="{{item.id}}" bindtap="editWish" disabled="{{submitting}}">编辑房间、数量与备注 / Edit</button></block>
<block wx:elif="{{tab==='orders'}}"><view class="tiny">{{item.number}}</view><view class="row between"><view class="price">{{item.priceText}}</view><view class="pill tone-{{item.statusTone}}">{{item.statusText}}</view></view><view class="muted">客服 {{item.service_name}} / {{item.shipment_status}}</view><button data-id="{{item.id}}" bindtap="openOrder">订单详情 / Details</button></block>
<block wx:elif="{{tab==='inquiries'}}"><view>{{item.requirements.project_name||'询价 / Inquiry'}} #{{item.id}}</view><view wx:if="{{item.estimate}}" class="muted">参考合计 {{item.estimateText}}<text wx:if="{{item.budgetText}}"> · 预算 {{item.budgetText}}</text></view><view wx:if="{{item.requirements.needed_by}}" class="tiny">期望到货 {{item.requirements.needed_by}} · {{item.requirements.destination}}</view><view wx:if="{{item.requirements.allow_alternatives}}" class="tiny">可以协商替代款，须客户确认</view><view class="muted">{{item.summary}}</view><view class="pill">{{item.statusText}}</view><button data-id="{{item.id}}" bindtap="openInquiry">查看与沟通 / View and discuss</button></block>
<block wx:elif="{{tab==='tickets'}}"><view>售后 / Ticket #{{item.id}} · {{item.status}}</view><view class="muted">{{item.description}}</view><view class="tiny" wx:for="{{item.history}}" wx:for-item="h" wx:key="at">{{h.by}}: {{h.note}}</view><button wx:if="{{item.status==='need_information'}}" data-id="{{item.id}}" bindtap="supplement">补充资料 / Add information</button></block>
<block wx:elif="{{tab==='quotes'}}"><view class="row between"><view>{{item.sku_code}} · v{{item.version}}</view><view class="pill tone-{{item.statusTone}}">{{item.statusText}}</view></view><view class="price">{{item.priceText}}</view><view class="tiny">库存 {{item.available_quantity===null?'待确认':item.available_quantity}} · 交期 {{item.lead_days}} 天</view><view class="muted">{{item.reason}}</view><view wx:if="{{!item.deleted}}" class="row wrap"><button class="small" data-id="{{item.id}}" bindtap="revise">修改报价 / Revise</button><button class="small" data-id="{{item.id}}" data-action="{{item.active?'withdraw':'resubmit'}}" bindtap="quoteAction">{{item.active?'下架 / Withdraw':'重新上架 / Resubmit'}}</button><button class="small" data-id="{{item.id}}" data-action="delete" bindtap="quoteAction">删除 / Delete</button></view></block>
<block wx:elif="{{tab==='catalog'}}"><view class="row"><image class="thumb" src="{{item.picture}}"/><view><view>{{item.name}}</view><view class="tiny">{{item.title}}</view><view class="pill tone-{{item.statusTone}}">{{item.statusText}}</view></view></view><button data-id="{{item.id}}" bindtap="editProduct">编辑并重新审核 / Edit</button></block></view></block><view wx:if="{{!visibleRows.length}}" class="empty">暂无记录 / No records</view>
<button wx:if="{{tab==='orders'&&hasMore}}" bindtap="moreOrders">加载更多订单 / Load more orders</button><view wx:if="{{modal}}" class="modal"><view class="sheet"><block wx:if="{{modal==='order'}}"><view class="section">订单详情 / Order</view><view class="tiny">{{order.number}}</view><view class="pill">{{order.status}}</view><view wx:for="{{order.lines}}" wx:key="id" class="card"><view>{{item.snapshot.product_name}}</view><view class="tiny">{{item.snapshot.code}} · {{item.snapshot.specification}}</view><view>{{item.quantity}} × {{item.priceText}} · 已发 {{item.shipped_quantity}}</view></view><view wx:if="{{order.address_snapshot}}" class="muted">{{order.address_snapshot.recipient}} {{order.address_snapshot.phone}} {{order.address_snapshot.detail}}</view><view wx:for="{{order.shipments}}" wx:for-item="ship" wx:key="id" class="card"><view>{{ship.carrier}} {{ship.tracking||'自提 / Pickup'}}</view><button wx:for="{{ship.proof_media_ids}}" wx:for-item="proof" wx:key="*this" data-id="{{proof}}" bindtap="proof">查看凭证 / Proof</button></view><block wx:if="{{order.status==='awaiting_confirmation'}}"><view class="check"><switch bindchange="delivery"/><text>{{form.delivery_mode==='delivery'?'配送 / Delivery':'自提 / Pickup'}}</text></view><picker wx:if="{{form.delivery_mode==='delivery'}}" range="{{addresses}}" range-key="detail" bindchange="selectAddress"><view class="picker">{{form.address_label||'选择收货地址 / Address'}}</view></picker><button class="primary" bindtap="confirm">确认订单 / Confirm</button></block><button wx:if="{{order.status==='awaiting_confirmation'||order.status==='confirmed'}}" bindtap="cancel">取消订单 / Cancel order</button><button wx:if="{{order.status==='fulfilling'}}" class="primary" bindtap="receive">全部签收 / Receive all</button><button wx:if="{{order.status==='completed'}}" bindtap="review">评价商品 / Review</button><button wx:if="{{order.status==='completed'||order.status==='fulfilling'}}" bindtap="ticket">申请售后 / After-sales</button></block>
<block wx:elif="{{modal==='wish'}}"><view class="section">编辑选购清单 / Edit list item</view><text class="field">房间名称 / Room</text><input disabled="{{submitting}}" value="{{form.room}}" maxlength="60" data-key="room" bindinput="input"/><text class="field">采购数量 / Quantity</text><input disabled="{{submitting}}" type="number" value="{{form.quantity}}" data-key="quantity" bindinput="input"/><text class="field">清单备注 / Notes</text><textarea disabled="{{submitting}}" value="{{form.note}}" maxlength="300" data-key="note" bindinput="input"/><view class="check"><switch disabled="{{submitting}}" checked="{{form.watch_price}}" data-key="watch_price" bindchange="input"/><text>关注价格变化 / Price watch</text></view><view class="check"><switch disabled="{{submitting}}" checked="{{form.watch_stock}}" data-key="watch_stock" bindchange="input"/><text>关注供货变化 / Supply watch</text></view><view class="notice">保存后更新清单，已有询价快照不受影响。</view><button class="primary" disabled="{{submitting}}" loading="{{submitting}}" bindtap="saveWish">保存清单修改 / Save changes</button></block><block wx:elif="{{modal==='review'||modal==='ticket'}}"><view class="section">{{modal==='review'?'商品评价 / Review':'售后申请 / After-sales'}}</view><picker range="{{order.lines}}" range-key="sku_id" bindchange="itemSelect"><view class="picker">{{form.itemLabel||'选择订单规格 / SKU'}}</view></picker><block wx:if="{{modal==='ticket'}}"><text class="field">数量 / Quantity</text><input type="number" value="{{form.quantity}}" data-key="quantity" bindinput="input"/><text class="field">说明 / Description</text><textarea data-key="description" bindinput="input"/></block><block wx:else><text class="field">评价 / Review</text><textarea data-key="text" bindinput="input"/></block><button bindtap="attach">{{form.media_id?'附件已上传':'上传图片或视频'}}</button><button class="primary" bindtap="submitFeedback">提交 / Submit</button></block>
<block wx:elif="{{modal==='inquiry'}}"><view class="section">采购需求 / Quote request</view><view class="muted">只发送已勾选项；预算与日期是期望，不构成交付承诺。</view><text class="field">项目名称 / Project</text><input disabled="{{sendingInquiry}}" value="{{form.project_name}}" data-key="project_name" bindinput="input"/><text class="field">商品预算 元 / Budget</text><input disabled="{{sendingInquiry}}" type="digit" value="{{form.budget}}" data-key="budget" bindinput="input"/><text class="field">期望到货 / Arrival date</text><picker disabled="{{sendingInquiry}}" mode="date" value="{{form.needed_by}}" data-key="needed_by" bindchange="input"><view class="picker">{{form.needed_by||'选择日期（可选）'}}</view></picker><text class="field">配送城市或区域 / Destination</text><input disabled="{{sendingInquiry}}" value="{{form.destination}}" data-key="destination" bindinput="input"/><view class="check"><switch disabled="{{sendingInquiry}}" checked="{{form.allow_alternatives}}" data-key="allow_alternatives" bindchange="input"/><text>可协商替代款，须我确认</text></view><text class="field">补充说明 / Notes</text><textarea disabled="{{sendingInquiry}}" value="{{form.message}}" data-key="message" bindinput="input"/><button loading="{{submitting}}" disabled="{{submitting}}" bindtap="previewInquiry">预览询价 / Preview</button><view wx:if="{{inquiryPreview}}"><view class="price">{{inquiryPreview.amountText}}</view><view wx:for="{{inquiryPreview.estimate.rooms}}" wx:for-item="room" wx:key="room" class="muted">{{room.room}} · {{room.quantity}} 件 · {{room.amountText}}</view><view wx:if="{{inquiryPreview.estimate.over_budget}}" class="notice">超出预算 {{inquiryPreview.gapText}}，仍可向客服询价协商。</view><view wx:for="{{inquiryPreview.estimate.issues}}" wx:for-item="issue" wx:key="index" class="muted">{{issue.message}}</view><button class="primary" loading="{{submitting}}" disabled="{{submitting||!inquiryPreview.can_submit}}" bindtap="submitInquiry">确认发送询价 / Send request</button></view></block><block wx:elif="{{modal==='inquiry-detail'}}"><view class="section">{{detail.requirements.project_name||'询价详情 / Inquiry'}} #{{detail.id}}</view><view class="pill">{{detail.status}}</view><view wx:for="{{detail.items}}" wx:for-item="line" wx:key="index" class="card"><view>{{line.snapshot.product_name||'SKU'}} {{line.snapshot.code||line.sku_id}}</view><view class="tiny">{{line.room}} × {{line.quantity}} · {{line.snapshot.specification}}</view></view><view class="section">沟通与处理记录 / Activity</view><view wx:for="{{detail.history}}" wx:for-item="event" wx:key="id" class="card"><view>{{event.actor_name}} · {{event.action}}</view><view class="tiny">{{event.created_at}} UTC</view><view class="muted">{{event.message||'已提交需求快照'}}</view></view><view wx:if="{{!detail.history.length}}" class="muted">旧询价尚无处理记录，原始需求仍保留。</view><block wx:if="{{detail.status==='open'}}"><text class="field">补充需求或问题 / Message</text><textarea data-key="reply" value="{{form.reply}}" maxlength="2000" bindinput="input"/><button class="primary" loading="{{submitting}}" disabled="{{submitting||!form.reply}}" bindtap="inquiryReply">发送信息 / Send message</button><button bindtap="beginWithdrawal" disabled="{{submitting}}">撤回本次询价 / Withdraw</button><view wx:if="{{form.withdraw}}" class="card"><view class="notice">撤回后不能继续转单，需求与处理记录会保留。需要调整选品时，请重新发起询价。</view><text class="field">撤回原因 / Reason</text><textarea data-key="reason" value="{{form.reason}}" maxlength="2000" bindinput="input"/><button loading="{{submitting}}" disabled="{{submitting||!form.reason}}" bindtap="withdrawInquiry">确认撤回 / Confirm withdrawal</button><button bindtap="cancelWithdrawal">继续沟通 / Keep discussing</button></view></block><view wx:else class="notice">本次询价已结束，历史记录只读。<button wx:if="{{detail.order_id}}" bindtap="linkedOrder">查看关联订单 / View order</button></view></block><block wx:elif="{{modal==='quote'}}"><view class="section">报价新版本 / Revise offer</view><text class="field">供货单价 ¥</text><input type="digit" value="{{form.price}}" data-key="price" bindinput="input"/><text class="field">库存数量</text><input type="number" value="{{form.available_quantity}}" data-key="available_quantity" bindinput="input"/><text class="field">交期 天</text><input type="number" value="{{form.lead_days}}" data-key="lead_days" bindinput="input"/><text class="field">运费 ¥</text><input type="digit" value="{{form.freight}}" data-key="freight" bindinput="input"/><button class="primary" bindtap="saveQuote">提交审核 / Submit</button></block>
<block wx:elif="{{modal==='product'||modal==='edit-product'}}"><view class="section">商品资料 / Product</view><text class="field">名称 / Name</text><input value="{{form.name}}" data-key="name" bindinput="input"/><text class="field">标题 / Title</text><input value="{{form.title}}" data-key="title" bindinput="input"/><text class="field">分类 / Category</text><input value="{{form.category}}" data-key="category" bindinput="input"/><text class="field">说明 / Description</text><textarea value="{{form.description}}" data-key="description" bindinput="input"/><block wx:if="{{modal==='product'}}"><text class="field">SKU</text><input data-key="code" bindinput="input"/><text class="field">尺寸 mm</text><input data-key="size_mm" bindinput="input"/><text class="field">规格 / Specification</text><input data-key="specification" bindinput="input"/><text class="field">初始价格 ¥</text><input type="digit" data-key="price" value="{{form.price}}" bindinput="input"/><text class="field">功率 W</text><input type="number" data-key="power_w" value="{{form.power_w}}" bindinput="input"/><text class="field">色温 K</text><input type="number" data-key="cct_k" value="{{form.cct_k}}" bindinput="input"/><button bindtap="productImage">{{form.image?'图片已上传':'上传商品图片'}}</button></block><button class="primary" bindtap="saveProduct">提交审核 / Submit</button></block>
<block wx:elif="{{modal==='supplement'}}"><view class="section">补充售后资料 / More information</view><textarea data-key="note" bindinput="input"/><button bindtap="attach">上传附件 / Upload</button><button class="primary" bindtap="saveSupplement">提交 / Submit</button></block><button bindtap="close">关闭 / Close</button></view></view></view>
