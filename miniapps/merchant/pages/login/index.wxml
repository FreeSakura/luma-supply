<view class="page"><view class="brand">☀ LumaSupply</view><view class="hero"><view class="eyebrow">LIGHTING · SOURCING · TOGETHER</view><view class="title">{{lang==='zh'?'让好设计遇见光。':'Find your light.'}}</view><view class="muted">{{role==='merchant'?'商家工作台 / Supplier workspace':'客户选灯空间 / Customer workspace'}}</view></view><view class="card"><view class="section">{{mode==='register'?'注册 / Register':mode==='reset'?'找回密码 / Reset':'登录 / Sign in'}}</view><block wx:if="{{mode!=='reset'}}"><text class="field">用户名 / Username</text><input data-key="username" bindinput="input" value="{{form.username}}"/></block><block wx:if="{{mode!=='login'}}"><text class="field">手机号 / Phone</text><input type="number" data-key="phone" bindinput="input"/><text class="field">验证码 / Code</text><view class="row"><input class="grow" data-key="code" bindinput="input"/><button class="small" bindtap="send">发送 / Send</button></view><view wx:if="{{devCode}}" class="notice">本地开发验证码 {{devCode}}，未发送短信</view></block><text class="field">密码 / Password</text><input password data-key="password" bindinput="input"/><view wx:if="{{mode==='register'}}" class="check"><switch checked="{{form.agreement}}" bindchange="agree"/><text>同意协议与隐私说明，资料用于履约，搜图不默认用于训练。</text></view><button class="primary" loading="{{busy}}" bindtap="submit">继续 / Continue</button><view class="row between"><button class="small" data-mode="login" bindtap="mode">登录</button><button class="small" data-mode="register" bindtap="mode">注册</button><button class="small" data-mode="reset" bindtap="mode">找回密码</button></view><button wx:if="{{role==='customer'}}" bindtap="wechat">微信授权登录 / WeChat login</button></view></view>
