/* Natural sheet height for short forms; long forms scroll within the viewport. */
.ops .admin-sheet{height:auto;max-height:84vh;overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain}
.ops .sheet-close{width:76rpx;height:76rpx;min-height:76rpx;flex-basis:76rpx}
.admin.ops .admin-actions .small,.merchant.ops .quote-actions .small{min-height:84rpx}
.merchant.ops .quote-actions .danger{min-width:84rpx;min-height:84rpx;justify-content:center;padding-left:10rpx;padding-right:5rpx}

.admin.ops.admin-profile .card .section{font-size:30rpx;display:flex;align-items:center;justify-content:space-between;gap:15rpx}

/* Room cards keep independent selection, product and editing regions. */
.customer .record-wishlist .wish-heading{display:flex;align-items:center;gap:12rpx;border-bottom:1rpx solid #ecf0e5;padding-bottom:14rpx;margin-bottom:22rpx}
.wish-selection{flex:1;min-width:0}
.customer .record-wishlist .wish-heading .check{margin:0;padding:0;border:0;min-height:64rpx}
.wish-heading checkbox{flex-shrink:0}
.wish-room{flex:1;min-width:0;overflow-wrap:break-word}
.wish-product{display:flex;align-items:center;gap:22rpx;min-width:0}
.wish-copy{flex:1;min-width:0}
.customer .wish-copy .record-title{font-size:29rpx;line-height:1.5;word-break:normal;overflow-wrap:break-word}
.customer .wish-copy .wish-sku{margin-top:7rpx;overflow-wrap:anywhere}
.customer .wish-copy .price{margin-top:10rpx;line-height:1.4;overflow-wrap:anywhere}
.customer .wish-note{padding:14rpx 18rpx;margin:12rpx 0;background:#f6f7f2;border-radius:12rpx;font-size:23rpx;white-space:pre-wrap;overflow-wrap:anywhere}
.customer .card-action text,.ops .card-action text{flex-shrink:0}
