/* Customer mobile surfaces use the same forest, sage and warm paper as web/src/theme.css. */
.auth-page,.customer,.ops{color:#253a33;font-size:28rpx;line-height:1.6}
.auth-page,.customer.page,.ops.page{padding:28rpx 32rpx 48rpx;padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}
.customer .grow,.auth-page .grow,.ops .grow{min-width:0}
.customer .muted,.auth-page .muted,.ops .muted{color:#748077;font-size:25rpx}
.customer .tiny,.ops .tiny{color:#7f8b7e;font-size:22rpx}
.customer .eyebrow,.auth-page .eyebrow,.ops .eyebrow{font-size:20rpx;letter-spacing:3rpx;color:#879374}
.customer .section,.ops .section{font-size:35rpx;color:#203c32;font-weight:600;letter-spacing:-1rpx}
.customer .card,.ops .card{border-color:#e3e6df;border-radius:24rpx;padding:28rpx;box-shadow:0 4rpx 18rpx #193c3503}
.customer .card>.section:first-child,.ops .card>.section:first-child{margin-top:0}
.customer input,.customer textarea,.customer .picker,.auth-page input,.ops input,.ops textarea,.ops .picker{background:#fafbf8;border:1rpx solid #dce2d7;border-radius:14rpx;font-size:28rpx;color:#253a33;min-height:88rpx;padding:20rpx 22rpx;box-sizing:border-box}
.input-placeholder{color:#a1a99c;font-size:26rpx}
.customer input,.ops input{height:92rpx}
.customer .field,.auth-page .field,.ops .field{font-size:25rpx;font-weight:500;color:#52635a}
.customer button,.auth-page button,.ops button{border-color:#dfe4da;color:#456052;border-radius:14rpx;font-size:26rpx;min-height:88rpx;line-height:1.5}
.customer button::after,.auth-page button::after,.ops button::after{border:0}
.customer .primary,.auth-page .primary,.ops .primary{background:#234d40;color:#fff;border:0;box-shadow:0 5rpx 14rpx #193c3510}
.customer button[disabled],.auth-page button[disabled],.ops button[disabled]{opacity:.48}
.customer .text-button,.auth-page .text-button,.ops .text-button{background:transparent;border:0;border-radius:0;box-shadow:none;padding:8rpx 0;min-height:72rpx;margin:0;font-size:24rpx;font-weight:400;gap:10rpx}
.customer .small,.ops .small{font-size:24rpx;min-height:76rpx}
.mobile-brand{display:flex;align-items:center;gap:14rpx;font-size:37rpx;color:#193c35;font-weight:600;letter-spacing:-1.3rpx;line-height:1.4}
.brand-light{font-weight:400}.mobile-brand .ui-icon{width:48rpx;height:48rpx}
.ui-icon{display:inline-block;width:38rpx;height:38rpx;flex-shrink:0;background-size:contain;background-position:center;background-repeat:no-repeat;vertical-align:middle}
/* The pendant is CSS artwork, matching the lamp motif on the web login. */
.lamp-scene{position:absolute;pointer-events:none;overflow:hidden}
.lamp-cord{position:absolute;top:0;left:50%;width:2rpx;height:91rpx;background:#5c6556}
.lamp-cap{position:absolute;left:calc(50% - 10rpx);top:86rpx;width:20rpx;height:17rpx;border-radius:8rpx 8rpx 0 0;background:#9b784e}
.lamp-shade{position:absolute;top:98rpx;left:calc(50% - 77rpx);width:154rpx;height:80rpx;border-radius:95rpx 95rpx 8rpx 8rpx;background:linear-gradient(105deg,#7a674b,#baa37d 42%,#9b845f);box-shadow:inset -12rpx -3rpx 20rpx #453b2920,0 10rpx 24rpx #8e784e15}
.lamp-light{position:absolute;top:172rpx;left:calc(50% - 71rpx);width:142rpx;height:9rpx;border-radius:50%;background:#fff3c6;box-shadow:0 6rpx 35rpx #fff1ad}
.lamp-glow{position:absolute;top:118rpx;left:calc(50% - 125rpx);width:250rpx;height:210rpx;border-radius:50%;background:radial-gradient(ellipse at center,#fff9df9c,transparent 70%)}
