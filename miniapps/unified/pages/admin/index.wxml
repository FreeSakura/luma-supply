<view class="page admin ops admin-module">
  <view class="admin-module-heading"><view class="module-heading-icon"><view class="ui-icon icon-{{moduleIcon}}"/></view><view class="grow"><view class="eyebrow">业务管理</view><view class="section">{{title}}</view><view class="muted">{{moduleNote}}</view></view></view>
  <view wx:if="{{error}}" class="notice">{{error}}</view>
  <block wx:if="{{module==='dashboard'}}">
    <view class="admin-metrics"><view class="metric-card"><view class="tiny">在售商品</view><view class="metric-number">{{dashboard.products||0}}</view></view><view class="metric-card"><view class="tiny">销售订单</view><view class="metric-number">{{dashboard.orders||0}}</view></view><view class="metric-card"><view class="tiny">已确认销售额</view><view class="metric-number small-number">{{dashboard.salesText}}</view></view><view class="metric-card"><view class="tiny">待审核报价</view><view class="metric-number">{{dashboard.pending_quotes||0}}</view></view></view>
    <view class="card"><view class="section">订单履约进度</view><view wx:for="{{orderStages}}" wx:key="key" class="row between order-stage"><view class="stage-name"><view class="stage-dot tone-{{item.key}}"/>{{item.label}}</view><view class="stage-count">{{dashboard.order_statuses[item.key]||0}}<text>单</text></view></view></view>
    <view class="admin-metrics"><view class="metric-card"><view class="tiny">待处理售后</view><view class="metric-number">{{dashboard.open_tickets||0}}</view></view><view class="metric-card"><view class="tiny">累计检索</view><view class="metric-number">{{dashboard.searches||0}}</view></view></view>
  </block>
  <block wx:elif="{{module==='settings'}}"><view class="tabs"><button data-key="customer_banners" bindtap="settingKey" class="{{settingKey==='customer_banners'?'active':''}}">客户轮播</button><button data-key="merchant_banners" bindtap="settingKey" class="{{settingKey==='merchant_banners'?'active':''}}">商家轮播</button><button data-key="support" bindtap="settingKey" class="{{settingKey==='support'?'active':''}}">客服</button></view><view wx:for="{{settingRows}}" wx:key="index" wx:for-item="row" wx:for-index="idx" class="card"><view class="tiny">第 {{idx+1}} 项</view><image wx:if="{{row.picture}}" class="setting-picture" mode="aspectFit" src="{{row.picture}}"/><button class="media-upload" data-index="{{idx}}" bindtap="settingUpload"><view class="ui-icon icon-upload"/>{{row.image?'更换图片':'上传图片'}}</button><text class="field">{{settingKey==='support'?'客服昵称':'标题'}}</text><input value="{{settingKey==='support'?row.nickname:row.title}}" data-index="{{idx}}" data-field="{{settingKey==='support'?'nickname':'title'}}" bindinput="settingInput"/><view wx:if="{{settingKey!=='support'}}"><text class="field">站内商品链接（填写商品路径）</text><input value="{{row.link}}" data-index="{{idx}}" data-field="link" bindinput="settingInput"/></view><button class="small" data-index="{{idx}}" bindtap="settingRemove">移除</button></view><view wx:if="{{!settingRows.length}}" class="empty settings-empty"><view class="empty-icon"><view class="ui-icon icon-layers"/></view><view class="empty-title">从第一项内容开始</view><view class="muted">添加轮播图片或客服资料，展示给对应用户。</view></view><button class="media-upload" bindtap="settingAdd">＋ 添加一项</button><button class="primary" loading="{{busy}}" bindtap="saveSettings">保存运营设置</button></block>
  <block wx:elif="{{module==='index'}}"><view class="card"><view class="section">检索索引</view><view>版本 {{dashboard.version||'未建立'}}</view><view class="muted">{{dashboard.encoder||'默认编码器'}} · {{dashboard.images||0}} 张图片</view><button class="primary" data-action="rebuild" bindtap="topAction">重建索引</button></view></block>
  <block wx:else>
    <view class="admin-tools {{module==='catalog'?'catalog-tools':''}}">
      <button wx:if="{{module==='catalog'}}" data-action="add-sku" bindtap="topAction">新增规格</button><button wx:if="{{module==='catalog'}}" data-action="changes" bindtap="topAction">资料变更</button><button wx:if="{{module==='catalog'}}" data-action="sku-review" bindtap="topAction">规格审核</button><button wx:if="{{module==='catalog'}}" data-action="pricing" bindtap="topAction">定价规则</button>
      <button wx:if="{{module==='orders'||module==='inquiries'}}" class="primary" data-action="new-order" bindtap="topAction">＋ 创建销售订单</button><button wx:if="{{module==='users'&&userRole==='admin'}}" class="primary" data-action="new-staff" bindtap="topAction">＋ 添加员工</button>
    </view>
    <view class="admin-search-box"><view class="ui-icon icon-search"/><input class="grow" placeholder="搜索编号、名称或关键词" placeholder-class="input-placeholder" value="{{query}}" bindinput="filterInput"/></view><view class="admin-list-toolbar row between"><view class="tiny">当前显示 {{rows.length}} 条记录</view><picker range="{{statusOptions}}" value="{{statusIndex}}" bindchange="statusPick"><view class="status-picker">{{statusLabel}}<text>⌄</text></view></picker></view>
  </block>
  <view wx:if="{{module!=='dashboard'&&module!=='settings'}}">
    <view wx:for="{{rows}}" wx:key="id" wx:for-item="row" class="card admin-row"><view class="row between"><view class="admin-row-title">{{row.title}}</view><view wx:if="{{row.statusText}}" class="pill tone-{{row.statusTone}}">{{row.statusText}}</view></view><view wx:if="{{row.amountText}}" class="record-amount">{{row.amountText}}<text>{{module==='quotes'?'供货单价':'订单金额'}}</text></view><view wx:if="{{row.subtitle}}" class="muted record-subtitle">{{row.subtitle}}</view><view class="admin-actions"><block wx:for="{{row.actions}}" wx:for-item="act" wx:for-index="actionIndex" wx:key="key"><button wx:if="{{actionIndex<2||row.expanded}}" class="small action-{{act.tone}}" disabled="{{busy}}" data-action="{{act.id}}" data-id="{{row.id}}" data-kind="{{row.kind}}" data-sku="{{act.skuId}}" bindtap="menuAction">{{act.label}}</button></block><button wx:if="{{row.actions.length>2}}" class="text-button more-actions" data-id="{{row.id}}" data-kind="{{row.kind}}" bindtap="toggleRowActions">{{row.expanded?'收起操作 −':'更多操作 +'}}</button></view></view>
    <view wx:if="{{loading}}" class="loading-note">正在加载记录…</view><view wx:if="{{!rows.length&&!loading&&!error}}" class="empty"><view class="empty-icon"><view class="ui-icon icon-{{query||statusFilter?'search':moduleIcon}}"/></view><view class="empty-title">{{query||statusFilter?'没有匹配的记录':'这里暂时没有待查看的记录'}}</view><view class="muted">{{query||statusFilter?'试试其他关键词或状态':'新的业务进展会显示在这里'}}</view></view><button wx:if="{{hasMore}}" loading="{{loading}}" bindtap="more">加载更多</button>
  </view>
  <view wx:if="{{modal==='detail'}}" class="modal"><view class="sheet admin-sheet"><view class="sheet-heading"><view><view class="eyebrow">业务明细</view><view class="section">记录详情</view></view><button class="sheet-close" aria-label="关闭" disabled="{{busy}}" bindtap="close">×</button></view><view wx:for="{{detailFields}}" wx:key="id" class="detail-field"><view class="tiny">{{item.label}}</view><view>{{item.value}}</view></view><view wx:for="{{detailSections}}" wx:key="id" wx:for-item="section"><view class="section">{{section.label}}</view><view wx:for="{{section.fields}}" wx:key="id" class="detail-field"><view class="tiny">{{item.label}}</view><view>{{item.value}}</view></view></view><view wx:if="{{detailPlan}}"><view class="section">采购方案</view><view class="price">¥{{detailPlan.total_cost/100}}</view><view wx:for="{{detailPlan.allocation}}" wx:key="quote_id" class="card">规格 #{{item.sku_id}} · 商家 #{{item.merchant_id}} · {{item.quantity}} 件</view></view><view wx:if="{{detailLines.length}}" class="section">明细</view><view wx:for="{{detailLines}}" wx:key="index" class="card"><view>{{item.snapshot.product_name||item.name||item.code||'规格 '+item.sku_id}}</view><view class="muted">{{item.snapshot.code||item.specification}} · {{item.quantity}} 件</view></view><view wx:if="{{detailHistory.length}}" class="section">记录</view><view wx:for="{{detailHistory}}" wx:key="index" class="card"><view>{{item.action||item.status||item.carrier}}</view><view class="muted">{{item.message||item.note||item.tracking||item.created_at}}</view><button wx:for="{{item.proof_media_ids}}" wx:for-item="proofId" wx:key="*this" data-id="{{proofId}}" bindtap="proof">查看发货凭证</button></view><button wx:for="{{detail.proof_media_ids}}" wx:key="*this" data-id="{{item}}" bindtap="proof">查看采购凭证</button><button bindtap="close">关闭</button></view></view>
  <view wx:if="{{modal==='plan-result'}}" class="modal"><view class="sheet admin-sheet"><view class="sheet-heading"><view><view class="eyebrow">采购协同</view><view class="section">采购方案建议</view></view><button class="sheet-close" aria-label="关闭" disabled="{{busy}}" bindtap="close">×</button></view><view class="pill">{{planStatusText}}</view><view class="price">¥{{plan.plan.total_cost/100}}</view><view wx:for="{{plan.plan.allocation}}" wx:key="quote_id" class="card"><view>规格 #{{item.sku_id}} · 商家 #{{item.merchant_id}}</view><view class="muted">{{item.quantity}} 件 · 货品成本 ¥{{item.goods_cost/100}}</view></view><view wx:for="{{plan.plan.reasons}}" wx:key="index" class="notice">{{item.reason}}</view><button bindtap="close">返回</button></view></view>
  <view wx:if="{{modal==='reauth'}}" class="modal"><view class="sheet admin-sheet admin-reauth"><view class="sheet-heading"><view><view class="eyebrow">账户安全</view><view class="section">重新验证身份</view></view><button class="sheet-close" aria-label="关闭" disabled="{{busy}}" bindtap="close">×</button></view><view class="notice">{{error}}</view><text class="field">当前密码</text><input password data-key="password" bindinput="input"/><text class="field">动态口令（已配置时填写）</text><input type="number" data-key="otp" bindinput="input"/><button class="primary" loading="{{busy}}" bindtap="reauth">验证并继续</button><button bindtap="close">取消</button></view></view>
  <view wx:if="{{modal==='form'}}" class="modal"><view class="sheet admin-sheet"><view class="sheet-heading"><view><view class="eyebrow">业务处理</view><view class="section">{{actionTitle}}</view></view><button class="sheet-close" aria-label="关闭" disabled="{{busy}}" bindtap="close">×</button></view><view wx:if="{{error}}" class="notice">{{error}}</view>
    <view class="admin-form-grid"><view wx:for="{{fields}}" wx:key="key" class="admin-form-field field-{{item.type}}"><text class="field">{{item.label}}</text>
      <textarea wx:if="{{item.type==='textarea'}}" value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="input"/>
      <switch wx:elif="{{item.type==='switch'}}" color="#234d40" checked="{{form[item.key]}}" data-key="{{item.key}}" bindchange="toggle"/>
      <picker wx:elif="{{item.type==='picker'}}" range="{{item.options}}" data-key="{{item.key}}" bindchange="pick"><view class="picker">{{formLabels[item.key]||'请选择'}}</view></picker>
      <picker wx:elif="{{item.type==='customer'}}" range="{{customers}}" range-key="name" bindchange="customerPick"><view class="picker">{{formLabels.customer_id||'选择客户'}}</view></picker>
      <picker wx:elif="{{item.type==='product'}}" range="{{products}}" range-key="name" bindchange="productPick"><view class="picker">{{formLabels.product_id||'选择商品'}}</view></picker>
      <checkbox-group wx:elif="{{item.type==='permissions'}}" class="permission-checkboxes" bindchange="permissionChange"><label wx:for="{{permissionOptions}}" wx:for-item="permission" wx:key="name" class="check"><checkbox color="#234d40" value="{{permission.name}}" checked="{{permission.checked}}"/>{{permission.label}}</label></checkbox-group>
      <button wx:elif="{{item.type==='proof'}}" data-key="proof" data-purpose="proof" bindtap="media">{{form.proof?'凭证已上传':'上传凭证图片'}}</button>
      <input wx:else type="{{item.type==='digit'?'digit':item.type==='number'?'number':item.type==='password'?'text':'text'}}" password="{{item.type==='password'}}" value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="input"/>
    </view></view>
    <view wx:if="{{action==='new-order'}}"><view class="section">订单商品</view><view wx:for="{{form.items}}" wx:key="index" wx:for-item="line" wx:for-index="idx" class="card"><picker range="{{skuOptions}}" range-key="label" data-index="{{idx}}" bindchange="skuPick"><view class="picker">{{line.label||'选择规格 '+line.sku_id}}</view></picker><text class="field">数量</text><input type="number" value="{{line.quantity}}" data-index="{{idx}}" data-field="quantity" bindinput="lineInput"/><text class="field">成交单价元（留空使用展示价）</text><input type="digit" value="{{line.unit_price}}" data-index="{{idx}}" data-field="unit_price" bindinput="lineInput"/><button class="small" data-index="{{idx}}" bindtap="removeLine">删除此项</button></view><button bindtap="addLine">增加商品</button></view>
    <view wx:if="{{action==='shipment'}}"><view class="section">发货明细</view><view wx:for="{{form.items}}" wx:key="line_id" wx:for-item="line" wx:for-index="idx" class="card"><view>{{line.label}}</view><input type="number" value="{{line.quantity}}" data-index="{{idx}}" data-field="quantity" bindinput="lineInput"/></view></view>
    <button wx:if="{{action==='add-sku'}}" data-key="image" data-purpose="product" bindtap="media">{{form.image?'商品图片已上传':'上传商品图片'}}</button>
    <button wx:if="{{action==='pricing'}}" bindtap="pricingPreview">预览价格影响</button><view wx:if="{{action==='pricing'}}" wx:for="{{pricingPreview}}" wx:key="code" class="card">{{item.code}}：¥{{item.old/100}} → ¥{{item.new/100}}</view>
    <button class="primary" disabled="{{busy||action==='pricing'&&!pricingPreview.length}}" loading="{{busy}}" bindtap="submit">确认提交</button><button bindtap="close">取消</button>
  </view></view>
</view>
