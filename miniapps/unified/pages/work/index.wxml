<view wx:if="{{admin}}" class="page admin ops admin-work"><view class="admin-hero"><view class="row between"><view class="eyebrow">灯具供应协同平台</view><view class="workspace-role">{{role==='admin'?'管理员':'员工'}}</view></view><view class="section">业务工作台</view><view class="muted">按业务查找入口，按权限处理工作。</view><view class="hero-rule"/></view><view wx:for="{{adminGroups}}" wx:for-item="group" wx:key="id" class="module-group">
  <view class="module-group-heading row between"><view class="section">{{group.label}}</view><text class="tiny">{{group.items.length}} 个模块</text></view>
  <view class="admin-menu"><button wx:for="{{group.items}}" wx:key="id" class="admin-menu-item" data-module="{{item.id}}" bindtap="adminOpen"><view class="module-icon"><view class="ui-icon icon-{{item.icon}}"/></view><view class="module-label">{{item.label}}<text>↗</text></view><view class="module-note">{{item.note}}</view></button></view>
</view><view wx:if="{{!adminLinks.length}}" class="empty">暂无已授权的工作模块</view><view class="ops-footer">LumaSupply · 让协同井然有序</view></view><block wx:else><view class="page {{role}} {{role==='merchant'?'ops':''}} work-page {{tab==='wishlist'&&rows.length?'has-checkout':''}}"><view class="work-heading"><view wx:if="{{role==='merchant'}}" class="workspace-kicker"><view class="ui-icon icon-store"/><text>商家工作空间</text></view><view wx:if="{{role==='customer'}}" class="eyebrow">我的灯光计划</view><view class="section">{{role==='merchant'?'我的供货工作台':'选购与订单'}}</view><view class="muted">{{role==='merchant'?'把握报价进度，及时更新供货。':'从房间清单到收货，进度都在这里。'}}</view></view><view class="tabs"><button wx:for="{{tabs}}" wx:key="key" class="{{tab===item.key?'active':''}}" data-key="{{item.key}}" bindtap="tab">{{item.name}}</button></view><view wx:if="{{tab==='wishlist'&&rows.length}}" class="card wish-summary"><view class="row between"><view class="summary-label"><view class="ui-icon icon-layers"/>按房间规划</view><view class="pill">{{rows.length}} 项灯具</view></view><picker range="{{roomOptions}}" value="{{roomIndex}}" bindchange="chooseRoom"><view class="picker">{{roomOptions[roomIndex]}}</view></picker><view class="tiny summary-note">选择房间，集中规划每个空间的用灯。</view></view><view wx:if="{{role==='merchant'}}" class="merchant-tools"><view class="tiny">{{tab==='quotes'?'管理供货版本与审核进度':'维护商品，拓展供货选择'}}</view><button wx:if="{{tab==='quotes'}}" class="small import-trigger" bindtap="openImport"><view class="ui-icon icon-upload"/>批量报价</button><button wx:if="{{tab==='catalog'}}" class="primary small" bindtap="newProduct">＋ 新增商品</button></view>
<picker wx:if="{{tab==='inquiries'}}" range="{{inquiryStatusOptions}}" value="{{inquiryStatusIndex}}" bindchange="inquiryStatus"><view class="picker">{{inquiryStatusOptions[inquiryStatusIndex]}}</view></picker><view class="work-filter"><input value="{{filterText}}" bindinput="filterInput" placeholder="搜索编号、商品或项目…"/><scroll-view scroll-x class="quote-filter-scroll" show-scrollbar="{{false}}" wx:if="{{tab==='quotes'}}"><view class="filter-chips"><button wx:for="{{quoteFilters}}" wx:key="value" class="{{filterStatus===item.value?'active':''}}" data-status="{{item.value}}" bindtap="filterOffers">{{item.label}}</button></view></scroll-view><view class="tiny">显示 {{visibleRows.length}} / {{rows.length}} 条记录</view></view><block wx:for="{{visibleRows}}" wx:key="id"><view class="card record-card record-{{tab}}"><block wx:if="{{tab==='wishlist'}}"><view class="wish-heading">
  <checkbox-group class="wish-selection" data-id="{{item.id}}" bindchange="toggleWish"><label class="check"><checkbox color="#234d40" value="{{item.id}}" checked="{{item.selected}}"/><text class="wish-room">{{item.room}} · {{item.sku.code}}</text></label></checkbox-group>
  <button class="small delete-wish" aria-label="移除灯具" data-id="{{item.id}}" bindtap="deleteWish"><view class="ui-icon icon-trash"/></button>
</view>
<view class="wish-product">
  <image class="thumb" src="{{item.picture}}" mode="aspectFit"/>
  <view class="wish-copy"><view class="record-title">{{item.product_name}}</view><view class="tiny wish-sku">{{item.sku.code}}</view><view class="price">{{item.priceText}}</view></view>
</view>
<view class="wish-quantity">采购数量 <text>× {{item.quantity}}</text></view>
<view wx:if="{{item.note}}" class="muted wish-note">{{item.note}}</view>
<button class="small wish-edit" data-id="{{item.id}}" bindtap="editWish" disabled="{{submitting}}">编辑房间、数量与备注</button></block>
<block wx:elif="{{tab==='orders'}}"><view class="tiny">{{item.number}}</view><view class="row between"><view class="price">{{item.priceText}}</view><view class="pill tone-{{item.statusTone}}">{{item.statusText}}</view></view><view class="muted">客服 {{item.service_name}} / {{item.shipment_status}}</view><button data-id="{{item.id}}" bindtap="openOrder">订单详情</button></block>
<block wx:elif="{{tab==='inquiries'}}"><view>{{item.requirements.project_name||'询价'}} #{{item.id}}</view><view wx:if="{{item.estimate}}" class="muted">参考合计 {{item.estimateText}}<text wx:if="{{item.budgetText}}"> · 预算 {{item.budgetText}}</text></view><view wx:if="{{item.requirements.needed_by}}" class="tiny">期望到货 {{item.requirements.needed_by}} · {{item.requirements.destination}}</view><view wx:if="{{item.requirements.allow_alternatives}}" class="tiny">可以协商替代款，须客户确认</view><view class="muted">{{item.summary}}</view><view class="pill">{{item.statusText}}</view><button data-id="{{item.id}}" bindtap="openInquiry">查看与沟通</button></block>
<block wx:elif="{{tab==='tickets'}}"><view>售后工单 #{{item.id}} · {{item.statusText}}</view><view class="muted">{{item.description}}</view><view class="tiny" wx:for="{{item.history}}" wx:for-item="h" wx:key="at">{{h.by}}: {{h.note}}</view><button wx:if="{{item.status==='need_information'}}" data-id="{{item.id}}" bindtap="supplement">补充资料</button></block>
<block wx:elif="{{tab==='quotes'}}">
  <view class="row between quote-record-head"><view><view class="record-title">{{item.sku_code}}</view><view class="tiny">报价版本 {{item.version}}</view></view><view class="pill tone-{{item.statusTone}}">{{item.statusText}}</view></view>
  <view class="quote-price"><view class="price">{{item.priceText}}</view><text class="tiny">供货单价</text></view>
  <view class="quote-facts"><view><text class="tiny">可供数量</text><view>{{item.available_quantity===null?'待确认':item.available_quantity+' 件'}}</view></view><view><text class="tiny">参考交期</text><view>{{item.lead_days}} 天</view></view></view>
  <view wx:if="{{item.validText}}" class="quote-validity">有效期至 {{item.validText}}</view>
  <view wx:if="{{item.reason}}" class="quote-reason"><view class="ui-icon icon-alert"/><text>{{item.reason}}</text></view>
  <view wx:if="{{!item.deleted}}" class="row quote-actions"><button class="small quote-edit" data-id="{{item.id}}" bindtap="revise">修改报价</button><button class="small" data-id="{{item.id}}" data-action="{{item.active?'withdraw':'resubmit'}}" bindtap="quoteAction">{{item.active?'下架':'重新上架'}}</button><button class="text-button danger" data-id="{{item.id}}" data-action="delete" bindtap="quoteAction">删除</button></view>
</block>
<block wx:elif="{{tab==='catalog'}}"><view class="row merchant-product-row"><image class="thumb" src="{{item.picture}}" mode="aspectFill"/><view class="grow"><view class="record-title">{{item.name}}</view><view class="tiny">{{item.title}}</view><view class="pill tone-{{item.statusTone}}">{{item.statusText}}</view></view></view><button class="catalog-edit" data-id="{{item.id}}" bindtap="editProduct">编辑商品与资料<text>↗</text></button></block></view></block><view wx:if="{{!visibleRows.length}}" class="empty work-empty"><view class="empty-icon"><view class="ui-icon icon-{{tab==='wishlist'?'layers':tab==='orders'?'box':'message'}}"/></view><view class="empty-title">{{filterText?'没有匹配的记录':role==='merchant'?(tab==='quotes'?'好供货，从一份报价开始':'把好商品，带给更多空间'):tab==='wishlist'?'把喜欢的光，留在清单里':tab==='orders'?'你的灯光故事，即将开始':tab==='inquiries'?'好灯值得一个好报价':'暂时没有售后记录'}}</view><view class="muted">{{filterText?'试试其他编号、商品或项目名称':role==='merchant'?(tab==='quotes'?'选好商品规格，再提交价格、数量与交期。':'新增商品，完善资料后提交平台审核。'):tab==='wishlist'?'选好灯具，按房间整理，再一起询价。':tab==='orders'?'订单确认后，可在这里跟进到货进度。':tab==='inquiries'?'从选购清单发起询价，在这里与客服沟通。':'订单中的售后进度，会为你保存在这里。'}}</view><button wx:if="{{role==='customer'&&!filterText}}" class="small" bindtap="browse">去发现好灯 ↗</button><button wx:if="{{role==='merchant'&&!filterText&&tab==='quotes'}}" class="small" bindtap="browse">去选品并报价 ↗</button><button wx:if="{{role==='merchant'&&!filterText&&tab==='catalog'}}" class="small" bindtap="newProduct">＋ 新增商品</button></view>
<view wx:if="{{role==='customer'&&tab==='wishlist'&&rows.length&&!modal}}" class="wishlist-checkout"><view class="grow"><view class="tiny">已选 {{selectedIds.length}} 项 · {{selectedQuantity}} 件</view><view class="checkout-amount">{{selectedAmount}}<text>参考合计</text></view></view><button class="primary" disabled="{{!selectedIds.length}}" bindtap="inquire">一键询价<text>→</text></button><view class="checkout-note">参考金额不含运费与安装</view></view>
<button wx:if="{{tab==='orders'&&hasMore}}" bindtap="moreOrders">加载更多订单</button><view wx:if="{{role==='merchant'&&modal==='import'}}" class="modal"><view class="sheet"><view class="sheet-heading"><view><view class="eyebrow">商家供货</view><view class="section">批量导入报价</view></view><button class="sheet-close" aria-label="关闭" bindtap="close">×</button></view><view class="muted">请按模板填写规格编码、单价、数量、起订量、交期、运费和有效日期；先预检再提交。</view><button bindtap="copyTemplate">复制报价模板</button><button bindtap="chooseCsv">从微信文件中选择报价表</button><view class="import-count"><view class="ui-icon icon-upload"/><text>{{importRows.length}} 行待导入</text></view><view wx:for="{{importErrors}}" wx:key="row" class="notice">第 {{item.row}} 行：{{item.message}}</view><button wx:if="{{importRows.length&&!importErrors.length}}" class="primary" bindtap="commitImport">确认导入并提交审核</button><button bindtap="close">关闭</button></view></view><view wx:if="{{modal&&modal!=='import'}}" class="modal"><view class="sheet"><view wx:if="{{role==='merchant'}}" class="sheet-heading"><view><view class="eyebrow">商家供货</view><view class="section">{{modal==='quote'?'修改供货报价':modal==='product'?'新增商品':'编辑商品资料'}}</view></view><button class="sheet-close" aria-label="关闭" bindtap="close">×</button></view><block wx:if="{{modal==='order'}}"><view class="section">订单详情</view><view class="tiny">{{order.number}}</view><view class="pill">{{order.statusText}}</view><view wx:for="{{order.lines}}" wx:key="id" class="card"><view>{{item.snapshot.product_name}}</view><view class="tiny">{{item.snapshot.code}} · {{item.snapshot.specification}}</view><view>{{item.quantity}} × {{item.priceText}} · 已发 {{item.shipped_quantity}}</view></view><view wx:if="{{order.address_snapshot}}" class="muted">{{order.address_snapshot.recipient}} {{order.address_snapshot.phone}} {{order.address_snapshot.detail}}</view><view wx:for="{{order.shipments}}" wx:for-item="ship" wx:key="id" class="card"><view>{{ship.carrier}} {{ship.tracking||'自提'}}</view><button wx:for="{{ship.proof_media_ids}}" wx:for-item="proof" wx:key="*this" data-id="{{proof}}" bindtap="proof">查看凭证</button></view><block wx:if="{{order.status==='awaiting_confirmation'}}"><view class="check"><switch bindchange="delivery"/><text>{{form.delivery_mode==='delivery'?'配送':'自提'}}</text></view><picker wx:if="{{form.delivery_mode==='delivery'}}" range="{{addresses}}" range-key="detail" bindchange="selectAddress"><view class="picker">{{form.address_label||'选择收货地址'}}</view></picker><button class="primary" bindtap="confirm">确认订单</button></block><button wx:if="{{order.status==='awaiting_confirmation'||order.status==='confirmed'}}" bindtap="cancel">取消订单</button><button wx:if="{{order.status==='fulfilling'}}" class="primary" bindtap="receive">全部签收</button><button wx:if="{{order.status==='completed'}}" bindtap="review">评价商品</button><button wx:if="{{order.status==='completed'||order.status==='fulfilling'}}" bindtap="ticket">申请售后</button></block>
<block wx:elif="{{modal==='wish'}}"><view class="section">编辑选购清单</view><text class="field">房间名称</text><input disabled="{{submitting}}" value="{{form.room}}" maxlength="60" data-key="room" bindinput="input"/><text class="field">采购数量</text><input disabled="{{submitting}}" type="number" value="{{form.quantity}}" data-key="quantity" bindinput="input"/><text class="field">清单备注</text><textarea disabled="{{submitting}}" value="{{form.note}}" maxlength="300" data-key="note" bindinput="input"/><view class="check"><switch disabled="{{submitting}}" checked="{{form.watch_price}}" data-key="watch_price" bindchange="input"/><text>关注价格变化</text></view><view class="check"><switch disabled="{{submitting}}" checked="{{form.watch_stock}}" data-key="watch_stock" bindchange="input"/><text>关注供货变化</text></view><view class="notice">保存后更新清单，已有询价快照不受影响。</view><button class="primary" disabled="{{submitting}}" loading="{{submitting}}" bindtap="saveWish">保存清单修改</button></block><block wx:elif="{{modal==='review'||modal==='ticket'}}"><view class="section">{{modal==='review'?'商品评价':'售后申请'}}</view><picker range="{{order.lines}}" range-key="sku_id" bindchange="itemSelect"><view class="picker">{{form.itemLabel||'选择订单规格'}}</view></picker><block wx:if="{{modal==='ticket'}}"><text class="field">数量</text><input type="number" value="{{form.quantity}}" data-key="quantity" bindinput="input"/><text class="field">说明</text><textarea data-key="description" bindinput="input"/></block><block wx:else><text class="field">评价</text><textarea data-key="text" bindinput="input"/></block><button bindtap="attach">{{form.media_id?'附件已上传':'上传图片或视频'}}</button><button class="primary" bindtap="submitFeedback">提交</button></block>
<block wx:elif="{{modal==='inquiry'}}"><view class="section">采购需求</view><view class="muted">只发送已勾选项；预算与日期是期望，不构成交付承诺。</view><text class="field">项目名称</text><input disabled="{{sendingInquiry}}" value="{{form.project_name}}" data-key="project_name" bindinput="input"/><text class="field">商品预算 元</text><input disabled="{{sendingInquiry}}" type="digit" value="{{form.budget}}" data-key="budget" bindinput="input"/><text class="field">期望到货</text><picker disabled="{{sendingInquiry}}" mode="date" value="{{form.needed_by}}" data-key="needed_by" bindchange="input"><view class="picker">{{form.needed_by||'选择日期（可选）'}}</view></picker><text class="field">配送城市或区域</text><input disabled="{{sendingInquiry}}" value="{{form.destination}}" data-key="destination" bindinput="input"/><view class="check"><switch disabled="{{sendingInquiry}}" checked="{{form.allow_alternatives}}" data-key="allow_alternatives" bindchange="input"/><text>可协商替代款，须我确认</text></view><text class="field">补充说明</text><textarea disabled="{{sendingInquiry}}" value="{{form.message}}" data-key="message" bindinput="input"/><button loading="{{submitting}}" disabled="{{submitting}}" bindtap="previewInquiry">预览询价</button><view wx:if="{{inquiryPreview}}"><view class="price">{{inquiryPreview.amountText}}</view><view wx:for="{{inquiryPreview.estimate.rooms}}" wx:for-item="room" wx:key="room" class="muted">{{room.room}} · {{room.quantity}} 件 · {{room.amountText}}</view><view wx:if="{{inquiryPreview.estimate.over_budget}}" class="notice">超出预算 {{inquiryPreview.gapText}}，仍可向客服询价协商。</view><view wx:for="{{inquiryPreview.estimate.issues}}" wx:for-item="issue" wx:key="index" class="muted">{{issue.message}}</view><button class="primary" loading="{{submitting}}" disabled="{{submitting||!inquiryPreview.can_submit}}" bindtap="submitInquiry">确认发送询价</button></view></block><block wx:elif="{{modal==='inquiry-detail'}}"><view class="section">{{detail.requirements.project_name||'询价详情'}} #{{detail.id}}</view><view class="pill">{{detail.statusText}}</view><view wx:for="{{detail.items}}" wx:for-item="line" wx:key="index" class="card"><view>{{line.snapshot.product_name||'规格'}} {{line.snapshot.code||line.sku_id}}</view><view class="tiny">{{line.room}} × {{line.quantity}} · {{line.snapshot.specification}}</view></view><view class="section">沟通与处理记录</view><view wx:for="{{detail.history}}" wx:for-item="event" wx:key="id" class="card"><view>{{event.actor_name}} · {{event.actionText}}</view><view class="tiny">{{event.created_at}} UTC</view><view class="muted">{{event.message||'已提交需求快照'}}</view></view><view wx:if="{{!detail.history.length}}" class="muted">旧询价尚无处理记录，原始需求仍保留。</view><block wx:if="{{detail.status==='open'}}"><text class="field">补充需求或问题</text><textarea data-key="reply" value="{{form.reply}}" maxlength="2000" bindinput="input"/><button class="primary" loading="{{submitting}}" disabled="{{submitting||!form.reply}}" bindtap="inquiryReply">发送信息</button><button bindtap="beginWithdrawal" disabled="{{submitting}}">撤回本次询价</button><view wx:if="{{form.withdraw}}" class="card"><view class="notice">撤回后不能继续转单，需求与处理记录会保留。需要调整选品时，请重新发起询价。</view><text class="field">撤回原因</text><textarea data-key="reason" value="{{form.reason}}" maxlength="2000" bindinput="input"/><button loading="{{submitting}}" disabled="{{submitting||!form.reason}}" bindtap="withdrawInquiry">确认撤回</button><button bindtap="cancelWithdrawal">继续沟通</button></view></block><view wx:else class="notice">本次询价已结束，历史记录只读。<button wx:if="{{detail.order_id}}" bindtap="linkedOrder">查看关联订单</button></view></block><block wx:elif="{{modal==='quote'}}"><view class="quote-price-input"><text class="field">供货单价（元）</text><input type="digit" value="{{form.price}}" placeholder="请输入供货单价" data-key="price" bindinput="input"/></view><view class="quote-field-grid"><view><text class="field">可供数量</text><input type="number" value="{{form.available_quantity}}" placeholder="留空为待确认" data-key="available_quantity" bindinput="input"/></view><view><text class="field">交期（天）</text><input type="number" value="{{form.lead_days}}" placeholder="如：3" data-key="lead_days" bindinput="input"/></view><view><text class="field">运费（元）</text><input type="digit" value="{{form.freight}}" placeholder="如：0" data-key="freight" bindinput="input"/></view><view><text class="field">起订量（件）</text><input type="number" value="{{form.min_quantity}}" placeholder="如：1" data-key="min_quantity" bindinput="input"/></view></view><text class="field">有效日期</text><picker mode="date" value="{{form.valid_until}}" data-key="valid_until" bindchange="input"><view class="picker row between">{{form.valid_until||'选择日期（默认 30 天）'}}<text>⌄</text></view></picker><view class="notice">每次提交产生新版本，审核通过后生效。</view><button class="primary" bindtap="saveQuote">提交审核</button></block>
<block wx:elif="{{modal==='product'||modal==='edit-product'}}"><view class="form-note">完善商品信息，提交后由平台审核。</view><text class="field">商品名称</text><input value="{{form.name}}" data-key="name" bindinput="input"/><text class="field">标题</text><input value="{{form.title}}" data-key="title" bindinput="input"/><text class="field">分类</text><input value="{{form.category}}" data-key="category" bindinput="input"/><text class="field">说明</text><textarea value="{{form.description}}" data-key="description" bindinput="input"/><block wx:if="{{modal==='product'}}"><text class="field">规格编码</text><input data-key="code" bindinput="input"/><text class="field">尺寸 mm</text><input data-key="size_mm" bindinput="input"/><text class="field">规格</text><input data-key="specification" bindinput="input"/><text class="field">初始价格 ¥</text><input type="digit" data-key="price" value="{{form.price}}" bindinput="input"/><text class="field">功率 W</text><input type="number" data-key="power_w" value="{{form.power_w}}" bindinput="input"/><text class="field">色温 K</text><input type="number" data-key="cct_k" value="{{form.cct_k}}" bindinput="input"/><button bindtap="productImage">{{form.image?'图片已上传':'上传商品图片'}}</button></block><button class="primary" bindtap="saveProduct">提交审核</button></block>
<block wx:elif="{{modal==='supplement'}}"><view class="section">补充售后资料</view><textarea data-key="note" bindinput="input"/><button bindtap="attach">上传附件</button><button class="primary" bindtap="saveSupplement">提交</button></block><button bindtap="close">关闭</button></view></view></view>
</block>