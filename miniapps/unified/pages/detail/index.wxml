<view wx:if="{{product}}" class="page {{role}} {{role==='merchant'?'ops':''}} detail-page"><view class="detail-gallery"><image class="detail-image" src="{{sku.picture}}" mode="aspectFit" bindtap="preview"/><view class="gallery-label">{{product.category}} · {{index+1}} / {{product.skus.length}} 个规格</view><view class="gallery-hint">轻触查看大图</view></view><view class="card detail-main"><view class="eyebrow">{{product.category}} / {{sku.code}}</view><view class="section">{{product.name}}</view><view class="muted">{{product.description}}</view><view class="detail-price-row"><view class="price">{{sku.priceText}}</view><text class="tiny">当前规格参考价</text></view><text class="field">选择规格</text><picker range="{{product.skus}}" range-key="label" value="{{index}}" bindchange="select"><view class="picker">{{sku.label}}</view></picker><view class="divider"/><view class="row between spec-row"><text class="muted">尺寸</text><text>{{sku.size_mm||'待补充'}}</text></view><view wx:for="{{sku.attributeList}}" wx:key="key" class="row between spec-row"><text class="muted">{{item.key}}</text><text>{{item.value}}</text></view><view class="row"><button class="grow" bindtap="compare">参数对比</button><button class="grow" open-type="share">分享规格</button></view><block wx:if="{{role==='customer'}}"><view class="room-label row between"><text class="field">放在哪个空间？</text><text class="tiny">按房间整理选购清单</text></view><input value="{{room}}" maxlength="60" data-key="room" bindinput="input" placeholder="如：客厅、卧室"/><view class="detail-purchase"><button class="primary" bindtap="wish"><view class="ui-icon icon-plus"/>加入选购清单<text>→</text></button><view class="tiny">先收藏心意，再与客服确认报价与交付。</view></view></block><button wx:elif="{{role==='merchant'}}" class="primary merchant-quote-cta" bindtap="quote">提交供货报价<text>↗</text></button></view><view class="card support"><view class="section">{{role==='merchant'?'供货合作，一起做好':'让选灯，更省心'}}</view><view class="muted">{{role==='merchant'?'联系平台客服，沟通供货与商品资料。':'联系专属客服，沟通批发、定制与交付。'}}</view><view wx:if="{{!support.length}}" class="tiny">{{role==='merchant'?'选定规格后，可在这里提交供货报价。':'可从选购清单发起询价，与客服沟通需求。'}}</view><view wx:for="{{support}}" wx:key="image"><image src="{{item.picture}}" data-url="{{item.picture}}" bindtap="support"/><view>{{item.nickname}}</view></view></view><view wx:if="{{reviews.length}}" class="section review-heading">灯光体验 · {{reviews.length}}</view><view class="card review-card" wx:for="{{reviews}}" wx:key="id"><view>{{item.text}}</view><view class="muted">{{item.reply}}</view></view><view wx:if="{{quote}}" class="modal"><view class="sheet"><view class="sheet-heading"><view><view class="eyebrow">商家供货</view><view class="section">提交供货报价</view></view><button class="sheet-close" aria-label="关闭" bindtap="close">×</button></view><view class="quote-sku-context">{{product.name}}<view class="tiny">{{sku.label}}</view></view><view class="quote-price-input"><text class="field">供货单价（元）</text><input type="digit" value="{{form.price}}" placeholder="请输入供货单价" data-key="form.price" bindinput="input"/></view><view class="quote-field-grid"><view><text class="field">可供数量</text><input type="number" value="{{form.available_quantity}}" placeholder="留空为待确认" data-key="form.available_quantity" bindinput="input"/></view><view><text class="field">交期（天）</text><input type="number" value="{{form.lead_days}}" placeholder="如：3" data-key="form.lead_days" bindinput="input"/></view><view><text class="field">运费（元）</text><input type="digit" value="{{form.freight}}" placeholder="如：0" data-key="form.freight" bindinput="input"/></view><view><text class="field">起订量（件）</text><input type="number" value="{{form.min_quantity}}" placeholder="如：1" data-key="form.min_quantity" bindinput="input"/></view></view><text class="field">有效日期</text><picker mode="date" value="{{form.valid_until}}" data-key="form.valid_until" bindchange="input"><view class="picker row between">{{form.valid_until||'选择日期（默认 30 天）'}}<text>⌄</text></view></picker><view class="notice">每次提交产生新版本，审核通过后生效。</view><button class="primary" bindtap="submitQuote">提交审核</button><button bindtap="close">取消</button></view></view><view wx:if="{{compareOpen}}" class="modal"><view class="sheet"><view class="section">规格对比</view><view wx:for="{{comparison}}" wx:key="id" class="card"><view>{{item.product_name}} · {{item.code}}</view><view class="price">{{item.priceText}}</view><view class="muted">{{item.color}} · {{item.size_mm}} · {{item.specification}}</view><view class="tiny">功率 {{item.attributes.power_w||'待补充'}} W · 色温 {{item.attributes.cct_k||'待补充'}} K</view></view><button bindtap="clearCompare">清除对比</button><button bindtap="close">返回</button></view></view></view>
