<view wx:if="{{admin}}" class="page admin ops admin-profile"><view class="profile-heading"><view class="eyebrow">我的工作空间</view><view class="section">账户与消息</view></view><view class="profile-banner"><view class="profile-avatar"><view class="ui-icon icon-shield"/></view><view class="grow"><view class="profile-title">{{profile.name||profile.username}}</view><view class="muted">{{role==='admin'?'管理员':'员工'}} · {{profile.username}}</view></view></view><view class="card permissions-card"><view class="section">工作权限<text class="section-note">{{role==='admin'?'全部模块':'已授权模块'}}</text></view><view class="permission-tags"><view wx:for="{{permissionList}}" wx:key="*this" class="permission-tag">{{item}}</view></view><view wx:if="{{!permissionList.length}}" class="tiny">暂无已分配权限，请联系管理员。</view></view><view class="card"><view class="section">消息中心<text class="section-note">{{unread?unread+' 条未读':'已读全部消息'}}</text></view><view wx:if="{{!notifications.length}}" class="profile-empty">暂无新消息，业务处理进展会在这里提醒你。</view><view wx:for="{{notifications}}" wx:key="id" class="ops-notification {{!item.read?'is-unread':''}}"><view>{{item.message}}</view><view class="tiny">{{item.created_at}}</view><view class="row notification-actions"><button wx:if="{{item.link}}" class="small" data-link="{{item.link}}" bindtap="openNotification">前往处理 ↗</button><button wx:if="{{!item.read}}" class="text-button" data-id="{{item.id}}" bindtap="markRead">标为已读</button></view></view></view><view class="account-actions"><button bindtap="password"><view class="ui-icon icon-shield"/>修改密码<text class="account-action-chevron">›</text></button><button bindtap="logout"><view class="ui-icon icon-logout"/>退出登录<text class="account-action-chevron">›</text></button></view><view wx:if="{{modal==='password'}}" class="modal"><view class="sheet"><view class="sheet-heading"><view class="section">修改密码</view><button class="sheet-close" aria-label="关闭" bindtap="close">×</button></view><text class="field">原密码</text><input password data-key="form.old_password" bindinput="input"/><text class="field">新密码</text><input password data-key="form.new_password" bindinput="input"/><button class="primary" bindtap="changePassword">确认修改</button><button bindtap="close">取消</button></view></view><view class="ops-footer">LumaSupply · 让协同井然有序</view></view><block wx:else><view class="page {{role}} {{role==='merchant'?'ops':''}} profile-page"><view class="row between"><view><view wx:if="{{role==='merchant'}}" class="eyebrow">商家工作空间</view><view class="section">{{role==='customer'?'我的空间':'商家资料'}}</view></view></view><view class="profile-banner"><view class="profile-avatar">{{role==='merchant'?'供':'我'}}</view><view class="grow"><view class="profile-title">{{profile.shop_name||profile.name||profile.username||'LumaSupply'}}</view><view class="muted">{{role==='merchant'?'维护认证资料，获得更多供货机会':'管理收货资料，让选购更顺畅'}}</view></view></view><view wx:if="{{role==='customer'}}" class="profile-links"><button data-tab="wishlist" bindtap="shortcut"><view class="ui-icon icon-layers"/><text>选购清单</text></button><button data-tab="orders" bindtap="shortcut"><view class="ui-icon icon-box"/><text>我的订单</text></button><button data-tab="tickets" bindtap="shortcut"><view class="ui-icon icon-shield"/><text>售后服务</text></button></view><view class="card profile-info"><view wx:if="{{role==='customer'}}" class="section">基本资料<text class="section-note">让沟通更亲近</text></view><block wx:if="{{role==='merchant'}}"><view class="row between certification-heading"><view class="section">认证资料</view><view class="pill tone-{{profile.status}}">{{profile.statusText||'待完善'}}</view></view><view class="form-note">完善店铺与资质信息，让合作更有保障。</view><view wx:if="{{profile.reason}}" class="quote-reason">{{profile.reason}}</view><text class="field">店铺名称</text><input value="{{profile.shop_name}}" data-key="profile.shop_name" bindinput="input"/><text class="field">法人姓名</text><input value="{{profile.legal_name}}" data-key="profile.legal_name" bindinput="input"/><text class="field">电话</text><input value="{{profile.phone}}" data-key="profile.phone" bindinput="input"/><text class="field">地址</text><input value="{{profile.address}}" data-key="profile.address" bindinput="input"/><button class="license-upload" bindtap="license"><view class="ui-icon icon-upload"/>{{profile.license_media_id?'更新营业执照':'上传营业执照'}}</button></block><block wx:else><text class="field">用户名</text><input value="{{profile.username}}" data-key="profile.username" bindinput="input"/><text class="field">姓名</text><input value="{{profile.name}}" data-key="profile.name" bindinput="input"/></block><button class="primary" bindtap="save">{{role==='merchant'?'提交认证审核':'保存资料'}}</button></view><view wx:if="{{role==='customer'}}" class="card"><view class="section">收货地址<text class="section-note">{{addresses.length}} 个地址</text></view><view wx:if="{{!addresses.length}}" class="profile-empty">还没有收货地址，先为好灯留个目的地。</view><view class="address-item" wx:for="{{addresses}}" wx:key="id"><view class="address-recipient">{{item.recipient}}<text>{{item.phone}}</text></view><view class="muted">{{item.detail}}</view><button class="text-button address-delete" data-id="{{item.id}}" bindtap="deleteAddress">删除地址</button></view><button class="add-address" bindtap="newAddress">＋ 添加收货地址</button></view><view class="card"><view class="section">消息中心<text class="section-note">{{unread?unread+' 条未读':'已读全部消息'}}</text></view><view wx:if="{{!notifications.length}}" class="profile-empty">暂无消息，询价和订单的新进展会在这里提醒你。</view><view class="notification-item {{!item.read?'is-unread':''}}" wx:for="{{notifications}}" wx:key="id"><view>{{item.message}}</view><button wx:if="{{item.link}}" class="small" data-link="{{item.link}}" bindtap="openNotification">查看相关业务</button><view class="tiny">{{item.created_at}}</view><button wx:if="{{!item.read}}" class="small" data-id="{{item.id}}" bindtap="markRead">标为已读</button><view class="divider"/></view></view><button wx:if="{{!demo}}" bindtap="bindWechat">绑定微信以便下次登录</button><view class="row"><button class="grow" bindtap="password">修改密码</button><button class="grow" bindtap="logout">退出</button></view><view wx:if="{{modal}}" class="modal"><view class="sheet"><view wx:if="{{role==='merchant'}}" class="sheet-heading"><view class="section">修改密码</view><button class="sheet-close" aria-label="关闭" bindtap="close">×</button></view><block wx:if="{{modal==='address'}}"><view class="section">添加收货地址</view><text class="field">收件人</text><input placeholder="请输入收件人姓名" value="{{form.recipient}}" data-key="form.recipient" bindinput="input"/><text class="field">电话</text><input type="number" placeholder="请输入联系电话" value="{{form.phone}}" data-key="form.phone" bindinput="input"/><text class="field">详细地址</text><textarea placeholder="省市区、街道及门牌号" value="{{form.detail}}" data-key="form.detail" bindinput="input"/><button class="primary" bindtap="saveAddress">保存</button></block><block wx:else><text class="field">原密码</text><input password data-key="form.old_password" bindinput="input"/><text class="field">新密码</text><input password data-key="form.new_password" bindinput="input"/><button class="primary" bindtap="changePassword">修改</button></block><button bindtap="close">关闭</button></view></view></view>
</block>