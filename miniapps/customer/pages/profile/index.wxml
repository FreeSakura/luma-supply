<view class="page"><view class="row between"><view class="section">{{lang==='zh'?'我的资料':'My profile'}}</view><button class="small" bindtap="language">{{lang==='zh'?'English':'中文'}}</button></view><view class="card"><block wx:if="{{role==='merchant'}}"><view class="pill">{{profile.status}}</view><view class="muted">{{profile.reason}}</view><text class="field">店铺名称 / Shop name</text><input value="{{profile.shop_name}}" data-key="profile.shop_name" bindinput="input"/><text class="field">法人姓名 / Legal representative</text><input value="{{profile.legal_name}}" data-key="profile.legal_name" bindinput="input"/><text class="field">电话 / Phone</text><input value="{{profile.phone}}" data-key="profile.phone" bindinput="input"/><text class="field">地址 / Address</text><input value="{{profile.address}}" data-key="profile.address" bindinput="input"/><button bindtap="license">{{profile.license_media_id?'更新营业执照 / Update license':'上传营业执照 / Upload license'}}</button></block><block wx:else><text class="field">用户名 / Username</text><input value="{{profile.username}}" data-key="profile.username" bindinput="input"/><text class="field">姓名 / Name</text><input value="{{profile.name}}" data-key="profile.name" bindinput="input"/></block><button class="primary" bindtap="save">{{role==='merchant'?'提交认证审核 / Submit verification':'保存资料 / Save profile'}}</button></view><view wx:if="{{role==='customer'}}" class="card"><view class="section">收货地址 / Addresses</view><view wx:for="{{addresses}}" wx:key="id"><view>{{item.recipient}} {{item.phone}}</view><view class="muted">{{item.detail}}</view><button class="small" data-id="{{item.id}}" bindtap="deleteAddress">删除 / Delete</button></view><button bindtap="newAddress">添加地址 / Add address</button></view><view class="card"><view class="section">消息 / Notifications · {{unread}}</view><view wx:for="{{notifications}}" wx:key="id"><view>{{item.message}}</view><view class="tiny">{{item.created_at}}</view><button wx:if="{{!item.read}}" class="small" data-id="{{item.id}}" bindtap="markRead">标为已读 / Mark read</button><view class="divider"/></view></view><view class="row"><button class="grow" bindtap="password">修改密码 / Password</button><button class="grow" bindtap="logout">退出 / Sign out</button></view><view wx:if="{{modal}}" class="modal"><view class="sheet"><block wx:if="{{modal==='address'}}"><view class="section">新地址 / Address</view><text class="field">收件人 / Recipient</text><input data-key="form.recipient" bindinput="input"/><text class="field">电话 / Phone</text><input data-key="form.phone" bindinput="input"/><text class="field">详细地址 / Address</text><textarea data-key="form.detail" bindinput="input"/><button class="primary" bindtap="saveAddress">保存 / Save</button></block><block wx:else><text class="field">原密码 / Current password</text><input password data-key="form.old_password" bindinput="input"/><text class="field">新密码 / New password</text><input password data-key="form.new_password" bindinput="input"/><button class="primary" bindtap="changePassword">修改 / Change</button></block><button bindtap="close">关闭 / Close</button></view></view></view>
