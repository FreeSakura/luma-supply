<view class="page"><view class="row between"><view class="brand">☀ LumaSupply</view><view class="pill">{{role==='merchant'?'供货选品':'发现灯具'}}</view></view><view class="hero"><view class="eyebrow">THE RIGHT LIGHT, EVERY TIME</view><view class="title">{{lang==='zh'?'找到灵感里的那束光。':'The light you imagined.'}}</view><view class="muted">{{lang==='zh'?'图片找灯 · 审核报价 · 采购协同':'Visual search · Reviewed quotes · Sourcing'}}</view></view><swiper wx:if="{{banners.length}}" autoplay circular style="height:240rpx"><swiper-item wx:for="{{banners}}" wx:key="image"><image style="width:100%;height:240rpx;border-radius:16rpx" mode="aspectFill" src="{{item.picture}}" data-link="{{item.link}}" bindtap="banner"/></swiper-item></swiper><view class="card"><input placeholder="搜索标题或 SKU / Search" value="{{text}}" data-key="text" bindinput="input" bindconfirm="search"/><view class="row"><button class="grow" bindtap="upload">{{image?'图片已上传 / Ready':'上传图片 / Image'}}</button><button class="primary grow" bindtap="search">检索 / Search</button></view><view class="row"><picker class="grow" range="{{categories}}" value="{{categoryIndex}}" bindchange="category"><view class="picker">{{categories[categoryIndex]}}</view></picker><input class="grow" type="digit" placeholder="预算 ¥" value="{{budget}}" data-key="budget" bindinput="input"/></view><view class="row between"><view class="check"><switch checked="{{available}}" bindchange="available"/><text>仅有货 / Available</text></view><button class="small" bindtap="clear">清除 / Clear</button></view><view wx:if="{{image}}"><view class="check"><switch bindchange="cropping"/><text>局部框选 / Crop</text></view><view wx:if="{{cropping}}" class="row"><input wx:for="{{['x','y','w','h']}}" wx:key="*this" type="digit" placeholder="{{item}} 0–1" data-key="crop.{{item}}" bindinput="input" value="{{crop[item]}}"/></view></view></view><view wx:if="{{notice}}" class="notice">{{notice}}<button class="small" bindtap="feedback">反馈 / Feedback</button></view><view class="section">{{lang==='zh'?'为每个空间精选灯具':'Curated for your space'}}</view><view class="grid"><view wx:for="{{products}}" wx:key="selected_sku_id" class="product" data-id="{{item.id}}" data-sku="{{item.selected_sku_id}}" bindtap="detail"><image src="{{item.picture}}" mode="aspectFill"/><view class="product-copy"><view class="tiny">{{item.skuCode}}</view><view class="product-name">{{item.name}}</view><view class="tiny">{{item.category}} · {{item.quote_count}} 家报价</view><view class="price">{{item.priceText}} <text class="tiny">起</text></view></view></view></view><view wx:if="{{!products.length}}" class="empty">暂无匹配 / No matches</view></view>
