<view class="page {{role}}"><view class="row between"><view class="brand">☀ LumaSupply</view><view class="pill">{{role==='merchant'?'供货选品':'发现灯具'}}</view></view><view class="hero"><view wx:if="{{role==='merchant'}}" class="eyebrow">SUPPLIER STUDIO</view><view class="eyebrow">THE RIGHT LIGHT, EVERY TIME</view><view class="title">{{role==='merchant'?(lang==='zh'?'供货有序，合作更顺畅。':'Keep your offers moving.'):(lang==='zh'?'为你的空间，选一束光。':'Find light for your space.')}}</view><view class="muted">{{role==='merchant'?'跟进报价，更新供货，发现新机会。':'从一张灵感图开始，找到合适的规格。'}}</view></view><view wx:if="{{role==='merchant'&&signedIn}}" class="supplier-grid"><view class="supplier-tile" data-tab="quotes" data-status="" bindtap="shortcut"><text class="tiny">全部报价 / Offers</text><text class="stat-value">{{supplierStats.total}}</text><text class="stat-link">供货工作台 ↗</text></view><view class="supplier-tile" data-tab="quotes" data-status="pending" bindtap="shortcut"><text class="tiny">等待审核 / Pending</text><text class="stat-value">{{supplierStats.pending}}</text><text class="stat-link">跟进审核 ↗</text></view><view class="supplier-tile" data-tab="quotes" data-status="rejected" bindtap="shortcut"><text class="tiny">需要修改 / Revise</text><text class="stat-value">{{supplierStats.rejected}}</text><text class="stat-link">查看原因 ↗</text></view><view class="supplier-tile" data-tab="quotes" data-status="expired" bindtap="shortcut"><text class="tiny">已到期 / Expired</text><text class="stat-value">{{supplierStats.expired}}</text><text class="stat-link">更新供货 ↗</text></view></view><view wx:if="{{role==='customer'}}" class="home-shortcuts"><button data-tab="wishlist" bindtap="shortcut">房间清单</button><button data-tab="inquiries" bindtap="shortcut">询价进度</button><button data-tab="orders" bindtap="shortcut">我的订单</button></view><swiper wx:if="{{banners.length}}" autoplay circular style="height:240rpx"><swiper-item wx:for="{{banners}}" wx:key="image"><image style="width:100%;height:240rpx;border-radius:16rpx" mode="aspectFill" src="{{item.picture}}" data-link="{{item.link}}" bindtap="banner"/></swiper-item></swiper><view class="card search-card"><view class="search-label">{{role==='merchant'?'找商品，提交供货报价':'搜索或上传图片，开始选灯'}}</view><input placeholder="搜索标题或 SKU / Search" value="{{text}}" data-key="text" bindinput="input" bindconfirm="search"/><view class="row"><button class="grow" bindtap="upload">{{image?'图片已上传 / Ready':'上传图片 / Image'}}</button><button class="primary grow" loading="{{loading}}" disabled="{{loading}}" bindtap="search">检索 / Search</button></view><view class="row"><picker class="grow" range="{{categories}}" value="{{categoryIndex}}" bindchange="category"><view class="picker">{{categories[categoryIndex]}}</view></picker><input class="grow" type="digit" placeholder="预算 ¥" value="{{budget}}" data-key="budget" bindinput="input"/></view><text class="field">色温 / Color temperature</text><picker range="{{cctOptions}}" value="{{cctIndex}}" bindchange="cct"><view class="picker">{{cctOptions[cctIndex]}}</view></picker><view class="tiny">K 表示光色，W 表示功率，比较光通量请看 lm。缺失参数需商家补充。</view><view class="row between"><view class="check"><switch checked="{{available}}" bindchange="available"/><text>仅有货 / Available</text></view><button class="small" bindtap="clear">清除 / Clear</button></view><view wx:if="{{image}}"><view class="check"><switch bindchange="cropping"/><text>局部框选 / Crop</text></view><view wx:if="{{cropping}}" class="row"><input wx:for="{{['x','y','w','h']}}" wx:key="*this" type="digit" placeholder="{{item}} 0–1" data-key="crop.{{item}}" bindinput="input" value="{{crop[item]}}"/></view></view></view><view wx:if="{{notice}}" class="notice">{{notice}}<button class="small" bindtap="feedback">反馈 / Feedback</button></view><view class="section">{{lang==='zh'?'为每个空间精选灯具':'Curated for your space'}}</view><view class="grid"><view wx:for="{{products}}" wx:key="selected_sku_id" class="product" data-id="{{item.id}}" data-sku="{{item.selected_sku_id}}" bindtap="detail"><image wx:if="{{item.picture}}" src="{{item.picture}}" mode="aspectFill"/><view wx:else class="product-placeholder">暂无图片 / No image</view><view class="product-copy"><view class="tiny">{{item.skuCode}}</view><view class="product-name">{{item.name}}</view><view class="tiny">{{item.category}} · {{item.quote_count}} 家报价</view><view class="price">{{item.priceText}} <text class="tiny">起</text></view><button wx:if="{{role==='merchant'}}" class="card-action" data-id="{{item.id}}" data-sku="{{item.selected_sku_id}}" catchtap="offer">立即报价 ↗</button><button wx:else class="card-action" data-id="{{item.id}}" data-sku="{{item.selected_sku_id}}" catchtap="detail">选规格 ↗</button></view></view></view><view wx:if="{{!searchMode}}" class="card"><view class="muted">已加载 / Loaded {{products.length}} / {{total}}</view><button wx:if="{{hasMore}}" loading="{{loading}}" disabled="{{loading}}" bindtap="loadMore">加载更多 / Load more</button><view wx:elif="{{loading}}" class="muted">正在加载 / Loading</view></view><view wx:if="{{!products.length&&!loading}}" class="empty">暂无匹配 / No matches</view></view>
