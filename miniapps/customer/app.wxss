page{background:#f5f7f1;color:#293f31;font-family:system-ui,-apple-system,'PingFang SC',sans-serif;font-size:28rpx}.page{padding:32rpx}.brand{font-size:38rpx;font-weight:600;letter-spacing:-1rpx}.eyebrow{font-size:19rpx;color:#94a183;letter-spacing:3rpx;margin-bottom:16rpx}.hero{padding:42rpx 34rpx;background:#e7ecdc;border-radius:20rpx;margin:28rpx 0}.hero .title{font-size:52rpx;line-height:1.5;font-weight:600}.muted{font-size:24rpx;color:#93a083;line-height:1.8}.card{background:white;border:1rpx solid #e2e8d8;border-radius:16rpx;padding:28rpx;margin:22rpx 0}.row{display:flex;gap:18rpx;align-items:center}.between{justify-content:space-between}.wrap{flex-wrap:wrap}.grow{flex:1}.section{font-size:34rpx;font-weight:600;margin:34rpx 0 18rpx}.field{display:block;font-size:24rpx;color:#788a68;margin:25rpx 0 10rpx}input,textarea,.picker{box-sizing:border-box;background:#fff;border:1rpx solid #dce4d0;border-radius:10rpx;padding:19rpx;width:100%;min-height:78rpx;color:#334a2c;font-size:26rpx}textarea{height:160rpx}.button,button{font-size:25rpx;border-radius:10rpx;margin:18rpx 0;padding:5rpx 24rpx;line-height:2.4;background:#fff;color:#3d5530;border:1rpx solid #dae3ce}button:after{border:none}.primary{background:#2d4735;color:white;border:0}.small{font-size:22rpx;margin:8rpx 0;padding:0 20rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.product{background:#fff;border:1rpx solid #e3e8d9;border-radius:15rpx;overflow:hidden}.product image{width:100%;height:235rpx;background:#efeee6}.product-copy{padding:21rpx}.product-name{font-size:28rpx;font-weight:600;margin:9rpx 0}.price{font-size:34rpx;font-weight:600;color:#445e35}.tiny{font-size:20rpx;color:#9eaa8e;line-height:1.8}.pill{font-size:22rpx;background:#e9efdf;border-radius:8rpx;padding:9rpx 16rpx;color:#7d9366}.tabs{display:flex;gap:16rpx;margin:24rpx 0;flex-wrap:wrap}.tabs button{font-size:23rpx;padding:0 24rpx;margin:0}.tabs .active{background:#344e3b;color:#fff}.detail-image{width:100%;height:490rpx;background:#efeee5;border-radius:18rpx}.divider{height:1rpx;background:#e8eddf;margin:25rpx 0}.empty{text-align:center;padding:70rpx 20rpx;font-size:26rpx;color:#99a58c}.notice{background:#edf1e5;padding:20rpx;border-radius:10rpx;color:#81946c;font-size:23rpx;line-height:1.8}.thumb{width:130rpx;height:105rpx;border-radius:8rpx;background:#efeee5}.support image{width:180rpx;height:180rpx}.modal{position:fixed;inset:0;background:#1b2b2180;display:flex;align-items:center;justify-content:center;padding:30rpx;z-index:20}.sheet{background:#fff;border-radius:20rpx;padding:32rpx;width:100%;max-height:84vh;overflow:auto;box-sizing:border-box}.check{display:flex;align-items:center;gap:10rpx;font-size:24rpx;margin:20rpx 0}switch{transform:scale(.8)}
